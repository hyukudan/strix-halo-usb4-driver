#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-only
"""Write the usb4stream-lab drop-in that ties the lab profile to ONE reviewed build.

usage: reviewed-kernel-dropin KERNELRELEASE [--output FILE]

KERNELRELEASE is the exact `make -s kernelrelease` of the build that passed
review, e.g. 7.3.0-rc5-strix-gpu-bosgame-20261020a. The release must use the
lab identity rules of tools/check_kconfig.py (lab prefix, a real build id, not
the fragment placeholder or the captured 20261014 build) and contain no glob
characters: the drop-in clears the unit's ConditionKernelVersion pattern and
allows exactly this release, so any other kernel (including a later rebuild
with a new identity) skips the lab service until it is reviewed in turn.

Install the output as
/etc/systemd/system/usb4stream-lab.service.d/10-reviewed-kernel.conf, then
`systemctl daemon-reload`. Without --output the drop-in is printed.
"""
import argparse
import importlib.util
from pathlib import Path
import re
import sys

TOOLS = Path(__file__).resolve().parents[1]
_spec = importlib.util.spec_from_file_location('check_kconfig', TOOLS / 'check_kconfig.py')
check_kconfig = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(check_kconfig)

BASE = '7.3.0-rc5'
INSTALL_PATH = '/etc/systemd/system/usb4stream-lab.service.d/10-reviewed-kernel.conf'


def validate(release):
    """Problem with a reviewed release, or None."""
    if re.search(r'[*?\[\]\s]', release):
        return f'{release!r} contains glob characters or spaces; give the exact release'
    if not release.startswith(BASE + check_kconfig.LAB_PREFIX):
        return f'{release!r} is not a {BASE}{check_kconfig.LAB_PREFIX}<id> lab build'
    local = release[len(BASE):]
    if local == check_kconfig.PLACEHOLDER:
        return 'the fragment placeholder is not a build identity'
    if local in check_kconfig.CAPTURED:
        return f'{local} is the captured pre-audit build, not a reviewed one'
    if not check_kconfig.SUFFIX.match(local[len(check_kconfig.LAB_PREFIX):]):
        return f'{release!r} has an invalid build id'
    return None


def render(release):
    return (f'# Lab profile restricted to the reviewed kernel build {release}.\n'
            f'# Generated by tools/lab/reviewed-kernel-dropin; install as\n'
            f'# {INSTALL_PATH}\n'
            '# The empty assignment clears the unit\'s lab-wide pattern; only this exact\n'
            '# release starts usb4stream-lab.service. Regenerate after reviewing a new build.\n'
            '[Unit]\n'
            'ConditionKernelVersion=\n'
            f'ConditionKernelVersion={release}\n')


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('release')
    parser.add_argument('--output', type=Path)
    args = parser.parse_args(argv)
    problem = validate(args.release)
    if problem:
        print(f'reviewed-kernel-dropin: {problem}', file=sys.stderr)
        return 1
    text = render(args.release)
    if args.output:
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_text(text)
    else:
        sys.stdout.write(text)
    return 0


if __name__ == '__main__':
    sys.exit(main())
