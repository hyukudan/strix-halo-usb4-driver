+ *	       the byte stream has a hole, reads fail with -EIO until close
  * @removed: Userspace removed the ConfigFS group underneath.
  * @detached: The open files lost their rings: the stream went away (the
  *	      rings were stopped then) or a resume could not restart them.
@@ -182,6 +184,7 @@ struct tbstream_dev {
 	cpumask_var_t irq_saved[2];
 	int users;
