-	else if (sf->frame.flags & RING_DESC_BUFFER_OVERRUN)
-		pr_warn("RX buffer overrun\n");
-	else
-		wake_up_interruptible_poll(&sdev->wait, EPOLLIN | EPOLLRDNORM);
+	/* read() fails the stream when it reaches this frame */
+	if (sf->frame.flags & (RING_DESC_CRC_ERROR | RING_DESC_BUFFER_OVERRUN)) {
+		pr_warn_ratelimited("%s: RX %s, reads fail from this frame on\n",
+				    sdev->misc.name,
+				    sf->frame.flags & RING_DESC_CRC_ERROR ?
+				    "CRC error" : "buffer overrun");
+		wake_up_interruptible_poll(&sdev->wait, EPOLLIN | EPOLLRDNORM | EPOLLERR);
+		return;
+	}
+	wake_up_interruptible_poll(&sdev->wait, EPOLLIN | EPOLLRDNORM);
+}
+
+static inline bool tbstream_frame_damaged(const struct tbstream_frame *sf)
+{
+	return sf->frame.flags & (RING_DESC_CRC_ERROR | RING_DESC_BUFFER_OVERRUN);
 }
 
