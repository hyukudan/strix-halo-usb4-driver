 EXPORT_SYMBOL_GPL(tb_unregister_dma_lifecycle_notifier);
 
+/**
+ * tb_domain_dma_retained() - Report one DMA owner still retained at teardown
+ * @tb: Domain being removed
+ *
+ * Only valid from a lifecycle notifier callback for QUIESCING or DMA_REVOKED,
+ * which run sequentially in the thread removing the domain.
+ */
+void tb_domain_dma_retained(struct tb *tb)
+{
+    WRITE_ONCE(tb->nhi->dma_retained, tb->nhi->dma_retained + 1);
+}
+EXPORT_SYMBOL_GPL(tb_domain_dma_retained);
+
+/* Revoke and verify PCI bus mastering. Clearing Bus Master Enable forbids
+ * the function from issuing new memory requests (descriptor/data DMA and
+ * MSI-X). The non-posted reads that follow cannot complete ahead of posted
+ * writes the function issued earlier (PCIe ordering, Relaxed Ordering off),
+ * so once they return no earlier DMA write is still in flight either.
+ * Consistent with the series' rule, a function that does not answer is no
+ * proof: the caller then abandons the retained owners instead. */
+static int tb_dma_revoke_bus_master(struct tb_nhi *nhi)
+{
+    struct pci_dev *pdev;
+    u16 command;
+
+    if (!dev_is_pci(nhi->dev))
+        return -EOPNOTSUPP;
+    pdev = to_pci_dev(nhi->dev);
+    if (!pci_device_is_present(pdev))
+        return -ENODEV;
+    pci_clear_master(pdev);
+    if (pci_read_config_word(pdev, PCI_COMMAND, &command) ||
+        (command & PCI_COMMAND_MASTER))
+        return -EIO;
+    (void)ioread32(nhi->iobase + REG_CAPS);
+    return 0;
+}
+
 /* Called by domain.c after CM stop and queued removal work have completed,
  * outside tb->lock, before deinit/unregister can discard the inventory. The
- * parent's remove path still owns its MMIO/devres while domain refs exist. */
+ * parent's remove path still owns its MMIO/devres while domain refs exist.
+ *
+ * A consumer that cannot prove its DMA stopped keeps its domain reference,
+ * and the parent would then wait for domain release forever. The removal
+ * itself offers a stronger proof than any per-ring one: after this point the
+ * controller is no longer needed, so revoke its bus mastering and let the
+ * retained owners release. Without that proof they are abandoned instead:
+ * they leak their DMA resources and never touch the controller again, and the
+ * parent's wait for the domain is bounded (see tb_domain_wait_released()). */
 static void tb_dma_retire_domain_clients(struct tb *tb)
 {
+    struct tb_nhi *nhi = tb->nhi;
+    unsigned int retained;
+    int ret;
+
+    WRITE_ONCE(nhi->dma_retained, 0);
     blocking_notifier_call_chain(&tb_dma_lifecycle_notifiers,
                                 TB_DMA_DOMAIN_QUIESCING, tb);
+    retained = READ_ONCE(nhi->dma_retained);
+    if (!retained)
+        return;
+    ret = tb_dma_revoke_bus_master(nhi);
+    if (!ret) {
+        WRITE_ONCE(nhi->dma_revoked, true);
+        dev_warn(&tb->dev, "%u DMA owner(s) retained at teardown: bus mastering revoked, releasing them\n",
+                 retained);
+        WRITE_ONCE(nhi->dma_retained, 0);
+        blocking_notifier_call_chain(&tb_dma_lifecycle_notifiers,
+                                    TB_DMA_DOMAIN_DMA_REVOKED, tb);
+        retained = READ_ONCE(nhi->dma_retained);
+        if (!retained)
+            return;
+    }
+    WRITE_ONCE(nhi->dma_abandoned, true);
+    dev_err(&tb->dev, "%u DMA owner(s) retained without a DMA stop proof (revoke: %d): abandoning them, their memory stays pinned until reboot\n",
+            retained, ret);
+    blocking_notifier_call_chain(&tb_dma_lifecycle_notifiers,
+                                TB_DMA_DOMAIN_ABANDONED, tb);
 }
 
 
