+/*
+ * Serializes the final domain release against tb_domain_wait_released()
+ * abandoning it. An abandoned domain no longer owns its NHI or control
+ * channel (both NULL), so a late release touches neither.
+ */
+static DEFINE_MUTEX(tb_domain_release_lock);
+
 static void tb_domain_release(struct device *dev)
 {
 	struct tb *tb = container_of(dev, struct tb, dev);
-	struct tb_nhi *nhi = tb->nhi;
+	struct tb_nhi *nhi;
 
-	tb_ctl_free(tb->ctl);
+	mutex_lock(&tb_domain_release_lock);
+	nhi = tb->nhi;
+	if (tb->ctl)
+		tb_ctl_free(tb->ctl);
 	destroy_workqueue(tb->wq);
 	ida_free(&tb_domain_ida, tb->index);
 	mutex_destroy(&tb->lock);
 	kfree(tb);
 
-	complete(&nhi->domain_released);
+	if (nhi)
+		complete(&nhi->domain_released);
+	mutex_unlock(&tb_domain_release_lock);
+}
+
+#define TB_DOMAIN_RELEASE_WARN_MS	10000
+#define TB_DOMAIN_RELEASE_TIMEOUT_MS	30000
+
+/**
+ * tb_domain_wait_released() - Bounded wait for the last domain reference
+ * @tb: Domain passed to tb_domain_remove(); may already have been freed
+ * @nhi: Its host interface, still owned by the caller
+ *
+ * Upstream waits forever. A DMA owner that cannot prove its transfers
+ * stopped deliberately keeps its domain reference, which used to hang
+ * reboot and NHI unbind. tb_domain_remove() now revokes bus mastering and
+ * lets such owners release, or abandons them. This bounds the remaining
+ * cases: if the domain is still referenced after the timeout (immediately
+ * when owners were abandoned), it is detached from @nhi and its control
+ * channel is freed now, while @nhi still exists. Whatever still holds the
+ * domain keeps a valid object; nothing reaches @nhi through it again.
+ *
+ * Return: %true if the domain was released, %false if it was abandoned.
+ */
+bool tb_domain_wait_released(struct tb *tb, struct tb_nhi *nhi)
+{
+	unsigned long warn = msecs_to_jiffies(TB_DOMAIN_RELEASE_WARN_MS);
+	unsigned long timeout = msecs_to_jiffies(TB_DOMAIN_RELEASE_TIMEOUT_MS);
+	struct tb_ctl *ctl;
+
+	if (READ_ONCE(nhi->dma_abandoned)) {
+		timeout = 0;
+	} else if (!wait_for_completion_timeout(&nhi->domain_released, warn)) {
+		dev_warn(nhi->dev, "domain still referenced after %u ms, waiting up to %u ms\n",
+			 TB_DOMAIN_RELEASE_WARN_MS, TB_DOMAIN_RELEASE_TIMEOUT_MS);
+		timeout -= warn;
+	} else {
+		return true;
+	}
+	if (timeout && wait_for_completion_timeout(&nhi->domain_released, timeout))
+		return true;
+
+	mutex_lock(&tb_domain_release_lock);
+	/* Not completed under the lock: the release has not run, @tb is alive. */
+	if (completion_done(&nhi->domain_released)) {
+		mutex_unlock(&tb_domain_release_lock);
+		return true;
+	}
+	ctl = tb->ctl;
+	tb->ctl = NULL;
+	tb->nhi = NULL;
+	WRITE_ONCE(nhi->dma_abandoned, true);
+	mutex_unlock(&tb_domain_release_lock);
+	/* Stopped by tb_domain_remove(); nothing uses it after removal. */
+	if (ctl)
+		tb_ctl_free(ctl);
+	dev_err(nhi->dev, "domain still referenced, abandoning it: its memory is leaked until reboot\n");
+	return false;
 }
 
