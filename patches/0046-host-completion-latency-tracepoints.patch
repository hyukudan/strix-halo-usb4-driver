diff --git a/include/trace/events/thunderbolt_latency.h b/include/trace/events/thunderbolt_latency.h
new file mode 100644
--- /dev/null
+++ b/include/trace/events/thunderbolt_latency.h
@@ -0,0 +1,43 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#undef TRACE_SYSTEM
+#define TRACE_SYSTEM thunderbolt
+
+#if !defined(_TRACE_THUNDERBOLT_LATENCY_H) || defined(TRACE_HEADER_MULTI_READ)
+#define _TRACE_THUNDERBOLT_LATENCY_H
+#include <linux/tracepoint.h>
+#include <linux/thunderbolt.h>
+
+/* stage: 1 IRQ, 2 worker entry, 3 reap, 4 worker end, 5 NAPI entry,
+ * 6 NAPI frame, 7 waitqueue wake, 8 descriptor publish, 9 RX ready,
+ * 10 TX credit. CPU/TID/time come from the trace event header.
+ * No per-packet timestamps or extra locks while this tracepoint is disabled.
+ */
+TRACE_EVENT(tb_latency,
+    TP_PROTO(const struct tb_ring *ring, const void *frame, unsigned int stage, u64 value),
+    TP_ARGS(ring, frame, stage, value),
+    TP_STRUCT__entry(
+        __field(unsigned long, ring)
+        __field(unsigned long, nhi)
+        __field(unsigned long, frame)
+        __field(unsigned int, stage)
+        __field(int, hop)
+        __field(bool, tx)
+        __field(u64, value)
+    ),
+    TP_fast_assign(
+        __entry->ring = (unsigned long)ring;
+        __entry->nhi = (unsigned long)ring->nhi;
+        __entry->frame = (unsigned long)frame;
+        __entry->stage = stage;
+        __entry->hop = ring->hop;
+        __entry->tx = ring->is_tx;
+        __entry->value = value;
+    ),
+    TP_printk("ring=%lx nhi=%lx frame=%lx stage=%u hop=%d tx=%d value=%llu",
+        __entry->ring, __entry->nhi, __entry->frame, __entry->stage,
+        __entry->hop, __entry->tx, (unsigned long long)__entry->value)
+);
+#endif
+#undef TRACE_INCLUDE_FILE
+#define TRACE_INCLUDE_FILE thunderbolt_latency
+#include <trace/define_trace.h>
