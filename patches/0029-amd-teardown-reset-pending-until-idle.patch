+}
+
+/**
+ * tb_domain_teardown_reset_stop() - Stop the teardown reset work
+ * @tb: Domain
+ * @removal: The domain is being removed (dma_shutdown is already set)
+ *
+ * Waits for a running attempt. For suspend the reset stays pending and
+ * tb_domain_teardown_reset_resume() re-arms it; on removal it is dropped.
+ */
+void tb_domain_teardown_reset_stop(struct tb *tb, bool removal)
+{
+	cancel_delayed_work_sync(&tb->teardown_reset_work);
+	if (removal && tb->nhi && nhi_teardown_reset_clear(tb->nhi))
+		dev_info(&tb->dev, "host interface reset after DMA teardown dropped: the domain is being removed\n");
+}
+
+/**
+ * tb_domain_teardown_reset_resume() - Re-arm a pending reset after resume
+ * @tb: Domain
+ */
+void tb_domain_teardown_reset_resume(struct tb *tb)
+{
+	struct tb_nhi *nhi = tb->nhi;
+	unsigned long flags;
+
+	if (!nhi)
 		return;
-	WRITE_ONCE(tb->teardown_reset_attempts, 0);
-	mod_delayed_work(tb->wq, &tb->teardown_reset_work,
-			 msecs_to_jiffies(TB_TEARDOWN_RESET_DELAY_MS));
+	spin_lock_irqsave(&nhi->lock, flags);
+	if (nhi->teardown_reset_pending && !nhi->going_away && !nhi->dma_shutdown)
+		tb_teardown_reset_arm_locked(tb);
+	spin_unlock_irqrestore(&nhi->lock, flags);
 }
 
