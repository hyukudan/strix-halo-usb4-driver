+/**
+ * tb_nhi_ring_freed() - A data ring of @nhi was freed
+ * @nhi: Host interface
+ *
+ * When the last data ring goes and a teardown reset is pending (parked or
+ * still in its fast attempts), queue it with a fresh budget. Never once
+ * the domain removal began.
+ */
+void tb_nhi_ring_freed(struct tb_nhi *nhi)
+{
+	unsigned long flags;
+	struct tb *tb;
+
+	spin_lock_irqsave(&nhi->lock, flags);
+	if (nhi->teardown_reset_pending && !nhi->dma_shutdown &&
+	    !nhi->going_away && nhi_data_rings_freed(nhi)) {
+		tb = dev_get_drvdata(nhi->dev);
+		if (tb)
+			tb_teardown_reset_arm_locked(tb);
+	}
+	spin_unlock_irqrestore(&nhi->lock, flags);
