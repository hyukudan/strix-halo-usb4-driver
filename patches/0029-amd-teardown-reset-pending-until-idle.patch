+/* Clears the pending reset; returns whether one was pending. */
+static bool nhi_teardown_reset_clear(struct tb_nhi *nhi)
+{
+	unsigned long flags;
+	bool pending;
+
+	spin_lock_irqsave(&nhi->lock, flags);
+	pending = nhi->teardown_reset_pending;
+	nhi->teardown_reset_pending = false;
+	nhi->teardown_reset_parked = false;
+	spin_unlock_irqrestore(&nhi->lock, flags);
+	return pending;
+}
+
+/* Under nhi->lock: no data ring allocated, the admission's ring condition. */
+static bool nhi_data_rings_freed(struct tb_nhi *nhi)
+{
+	unsigned int i;
+
+	for (i = 1; i < nhi->hop_count; i++) {
+		if (nhi->tx_rings[i] || nhi->rx_rings[i])
+			return false;
+	}
+	return true;
+}
+
+/*
+ * Queues the pending reset with a fresh budget of fast attempts. Under
+ * nhi->lock, which orders it against dma_shutdown: without it the domain
+ * removal has not started, so @tb and its workqueue are alive.
+ */
+static void tb_teardown_reset_arm_locked(struct tb *tb)
+{
+	tb->nhi->teardown_reset_parked = false;
+	WRITE_ONCE(tb->teardown_reset_attempts, 0);
+	mod_delayed_work(tb->wq, &tb->teardown_reset_work,
+			 msecs_to_jiffies(TB_TEARDOWN_RESET_DELAY_MS));
+}
+
+/*
+ * A reset owed after a DMA path teardown stays pending until it can run:
+ * it is never dropped because the NHI is busy. A few fast attempts cover a
+ * closing owner that frees its rings just after its paths; then it parks
+ * with no polling while other consumers hold the NHI, and the events that
+ * remove them re-arm it: the next path teardown and the free of the last
+ * data ring. The admission of __tb_domain_reset_dma() re-checks, under the
+ * domain lock and right before the reset, that nothing uses the NHI.
+ */
 static void tb_domain_teardown_reset_work(struct work_struct *work)
 {
 	struct tb *tb = container_of(to_delayed_work(work), struct tb,
 				     teardown_reset_work);
+	struct tb_nhi *nhi = tb->nhi;
 	unsigned int attempt = READ_ONCE(tb->teardown_reset_attempts) + 1;
+	unsigned long flags;
