 {
-    if (l->stop_confirmed || l->pending_callbacks >= 2U * SGU_MAX_FRAMES)
-        return 0;
-    ++l->pending_callbacks;
-    return 1;
+    return sgu_controller_queue_batch(l, 1);
 }
