+static inline int sgu_controller_queue_batch(struct sgu_controller_lifetime *l, __u32 count)
+{
+    if (!count || count > 2U * SGU_MAX_FRAMES || l->stop_confirmed ||
+        l->pending_callbacks > 2U * SGU_MAX_FRAMES - count)
+        return 0;
+    l->pending_callbacks += count;
+    return 1;
+}
+
