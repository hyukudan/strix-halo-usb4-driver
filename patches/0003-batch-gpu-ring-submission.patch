 }
@@ -360,4 +367,27 @@
 EXPORT_SYMBOL_GPL(__tb_ring_enqueue);
+
+/*
+ * Enqueue a caller-owned frame list atomically. On success the list is
+ * consumed and every frame receives the normal completion/cancel callback.
+ * On failure the list is untouched and no callback is owed. The caller
+ * must initialise all frames and account for all callbacks before entry.
+ */
+int __tb_ring_enqueue_list(struct tb_ring *ring, struct list_head *frames)
+{
+	unsigned long flags;
+	int ret = 0;
+
+	spin_lock_irqsave(&ring->lock, flags);
+	if (ring->running) {
+		list_splice_tail_init(frames, &ring->queue);
+		ring_write_descriptors(ring);
+	} else {
+		ret = -ESHUTDOWN;
+	}
+	spin_unlock_irqrestore(&ring->lock, flags);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(__tb_ring_enqueue_list);
 
