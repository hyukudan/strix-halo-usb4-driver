+/* Never block on sdev->lock: close cancels this work while holding that mutex. */
+static void sgu_watchdog(struct work_struct *work)
+{
+    struct tbstream_gpu_context *ctx = container_of(to_delayed_work(work),
+                                                   struct tbstream_gpu_context, watchdog);
+    struct tbstream_dev *sdev = ctx->sdev;
+    unsigned long flags;
+    u64 now = ktime_get_ns();
+    u32 direction, slot, i;
+    bool pending = false, expired = false;
+
+    if (!mutex_trylock(&sdev->lock)) {
+        if (!READ_ONCE(ctx->closing))
+            mod_delayed_work(system_wq, &ctx->watchdog, msecs_to_jiffies(100));
+        return;
+    }
+    if (ctx->closing || ctx->stopped)
+        goto unlock;
+    spin_lock_irqsave(&ctx->lock, flags);
+    for (direction = 0; direction < 2; ++direction) {
+        for (slot = 0; slot < ctx->queue_depth; ++slot) {
+            struct sgu_hw_operation *op = &ctx->operations[direction][slot];
+
+            if (!op->remaining)
+                continue;
+            pending = true;
+            if (now < op->deadline_ns)
+                continue;
+            expired = true;
+            op->error_flags |= SGU_FRAME_ERROR_TIMEOUT;
+            for (i = 0; i < op->total_frames; ++i) {
+                struct sgu_hw_frame *f = sgu_frame_at(ctx, op, i);
