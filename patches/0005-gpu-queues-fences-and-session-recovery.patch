+/* Apply the original wire validation before reserving the terminal bank. */
+static inline int sgu_prepare_queue_valid(const struct sgu_prepare *p, __u32 frames,
+                                         __u32 depth, __u32 *payload_frames)
+{
+    __u64 terminal;
+
+    if (!depth || depth > SGU_MAX_QUEUE_DEPTH || depth >= frames ||
+        !sgu_prepare_valid(p, frames, payload_frames))
+        return 0;
+    terminal = (__u64)(frames - depth) * SGU_FRAME_BYTES;
+    return p->pool_offset < terminal && p->payload_bytes <= terminal - p->pool_offset;
+}
+
+static inline int sgu_frame_ranges_overlap(__u64 a, __u32 na, __u64 b, __u32 nb)
+{
+    if (!na || !nb)
+        return 0;
+    return a <= b ? b - a < (__u64)na * SGU_FRAME_BYTES :
+                    a - b < (__u64)nb * SGU_FRAME_BYTES;
+}
+
+/* Separate timelines: failing one enqueue must not signal another slot. */
+static inline int sgu_owns_fence_context(__u64 base, __u64 context)
+{
+    return context >= base && context - base < 2U * SGU_MAX_QUEUE_DEPTH;
+}
