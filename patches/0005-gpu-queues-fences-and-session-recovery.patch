+            }
+        }
+    }
+    if (expired)
+        WRITE_ONCE(ctx->failed, true);
+    spin_unlock_irqrestore(&ctx->lock, flags);
+    if (READ_ONCE(ctx->failed)) {
+        if (expired)
+            dev_warn(ctx->dma_owner, "GPU stream DMA deadline expired; stopping session, not resetting NHI\n");
+        /* STOP drains/cancels callbacks. Never signal a still-owned buffer
+         * merely because a wall-clock deadline expired. */
+        tbstream_gpu_stop(sdev);
+    } else if (pending) {
+        mod_delayed_work(system_wq, &ctx->watchdog, msecs_to_jiffies(100));
+    }
+unlock:
+    mutex_unlock(&sdev->lock);
+}
