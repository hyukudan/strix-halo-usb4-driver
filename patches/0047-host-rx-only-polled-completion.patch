 CONFIGFS_ATTR(tbstream_dev_, busy_poll);
+
+/* Host RX only. Both modes require a bounded read/write loop, not poll(). */
+static ssize_t tbstream_dev_rx_busy_poll_show(struct config_item *item, char *buf)
+{
+	struct tbstream_dev *sdev = tbstream_dev_from_group(to_config_group(item));
+
+	return sysfs_emit(buf, "%u\n", sdev->rx_busy_poll);
+}
+
+static ssize_t tbstream_dev_rx_busy_poll_store(struct config_item *item,
+					     const char *buf, size_t count)
+{
+	struct tbstream_dev *sdev = tbstream_dev_from_group(to_config_group(item));
+	bool enabled;
+	int ret = kstrtobool(buf, &enabled);
+
+	if (ret)
+		return ret;
+	guard(mutex)(&sdev->lock);
+	if (tbstream_dev_config_busy(sdev))
+		return -EBUSY;
+#if IS_ENABLED(CONFIG_USB4_GPU_STREAM)
+	if (enabled && sdev->gpu_direct)
+		return -EOPNOTSUPP;
+#endif
+	sdev->rx_busy_poll = enabled;
+	return count;
+}
+CONFIGFS_ATTR(tbstream_dev_, rx_busy_poll);
 
