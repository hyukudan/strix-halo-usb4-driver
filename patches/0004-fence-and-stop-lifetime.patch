diff --git a/drivers/thunderbolt/gpu_stream.c b/drivers/thunderbolt/gpu_stream.c
--- a/drivers/thunderbolt/gpu_stream.c
+++ b/drivers/thunderbolt/gpu_stream.c
@@ -64,7 +64,8 @@
 static const char *sgu_fence_timeline(struct dma_fence *fence) { return "controller-dma"; }
 static void sgu_fence_free(struct dma_fence *fence)
 {
-    kfree(container_of(fence, struct sgu_dma_fence, base));
+    /* base is the first member; reservation readers require an RCU grace period. */
+    dma_fence_free(fence);
 }
 static const struct dma_fence_ops sgu_fence_ops = {
     .get_driver_name = sgu_fence_driver, .get_timeline_name = sgu_fence_timeline,
@@ -513,8 +514,15 @@
     ctx->stopped = true;
     spin_lock_irqsave(&ctx->lock, flags);
     ctx->lifetime.paths_removed = !ctx->armed;
-    if (!sgu_controller_stopped(&ctx->lifetime))
+    /* tb_ring_stop() can return early while the NHI is going away. Callback
+     * accounting alone must not authorise freeing an enabled DMA ring. */
+    if (sgu_ring_running(sdev->tx_ring.ring) ||
+        sgu_ring_running(sdev->rx_ring.ring)) {
+        ctx->lifetime.stop_confirmed = 0;
         WRITE_ONCE(ctx->failed, true);
+    } else if (!sgu_controller_stopped(&ctx->lifetime)) {
+        WRITE_ONCE(ctx->failed, true);
+    }
     spin_unlock_irqrestore(&ctx->lock, flags);
     wake_up_interruptible_poll(&sdev->wait, EPOLLIN | EPOLLERR);
 }
