+/*
+ * Sets one HopID of an attached device as one transaction: the new ID is
+ * allocated and published before the old one is released, so a failure
+ * leaves the device exactly as it was (still owning its old ID). Writing
+ * the ID the device already owns changes nothing; 0 releases it.
+ */
+static int tbstream_dev_set_hopid(struct tbstream_dev *sdev, bool in, int hopid)
+{
+	const char *name = config_item_name(&sdev->group.cg_item);
+	struct tbstream *stream = sdev->stream;
+	int cur = in ? sdev->in_hopid : sdev->out_hopid;
+	bool owned = in ? sdev->in_owned : sdev->out_owned;
+	int peer = in ? (sdev->out_owned ? sdev->out_hopid : 0) :
+			(sdev->in_owned ? sdev->in_hopid : 0);
+	int got = 0, ret;
+
+	lockdep_assert_held(&sdev->lock);
+	if (hopid == cur && (hopid == 0 || owned))
 		return 0;
-	}
