+	ret = tbstream_fault("hopid_props");
+	if (!ret)
+		ret = service_update_properties(stream->svc, name,
+						in ? got : peer,
+						in ? peer : got);
+	if (ret) {
+		if (got)
+			tbstream_dev_free_hopid(sdev, in, got);
 		return ret;
-	if (hopid > 0 && hopid != ret) {
-		tb_xdomain_release_out_hopid(xd, ret);
-		return -EBUSY;
-	}
-	sdev->out_hopid = ret;
