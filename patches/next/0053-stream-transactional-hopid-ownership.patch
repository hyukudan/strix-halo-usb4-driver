+/* Releases the HopID this device owns in one direction, if any */
+static void tbstream_dev_release_hopid(struct tbstream_dev *sdev, bool in)
+{
+	if (in && sdev->in_owned)
+		tbstream_dev_free_hopid(sdev, true, sdev->in_hopid);
+	else if (!in && sdev->out_owned)
+		tbstream_dev_free_hopid(sdev, false, sdev->out_hopid);
+	if (in)
+		sdev->in_owned = false;
+	else
+		sdev->out_owned = false;
