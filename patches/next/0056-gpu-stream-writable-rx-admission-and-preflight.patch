+
+/* PREFLIGHT (optional, additive): maps one buffer through exactly the validator
+ * IMPORT uses (identity, size, write access for RX, SG coverage, frame
+ * containment, DMA mask, TX/RX aliasing) and reports aggregate geometry only,
+ * then releases the mapping. It changes no ring, descriptor, path or import
+ * state, and is refused (EBUSY) once the context is armed or started. Input:
+ * fence ABI major/minor, buffer, direction; every output field zero.
+ * Discovery: SGU_IOC_QUEUE reports SGU_CAP_PREFLIGHT. */
+#define SGU_CAP_PREFLIGHT 512U
+struct sgu_preflight {
+    struct sgu_fence fence;
+    struct sgu_buffer buffer;
+    __u32 direction;
+    __u32 sg_entries;
+    __aligned_u64 mapped_bytes;
+    __aligned_u64 min_segment_bytes;
+    __aligned_u64 max_segment_bytes;
+    __u32 frames;
+    __u32 reserved;
+};
+
+#define SGU_IOC_PREFLIGHT _IOWR(0xb7, 0x52, struct sgu_preflight)
 
