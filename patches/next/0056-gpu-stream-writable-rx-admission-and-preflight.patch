 }
 
+/* Aggregate DMA geometry of a mapped window (PREFLIGHT, test-build IMPORT log) */
+static void sgu_window_geometry(const struct sgu_window *w, struct sgu_preflight *g)
+{
+    struct scatterlist *sg;
+    u32 i;
+
+    g->sg_entries = w->mapping->nents;
+    g->mapped_bytes = 0;
+    g->min_segment_bytes = U64_MAX;
+    g->max_segment_bytes = 0;
+    for_each_sg(w->mapping->sgl, sg, w->mapping->nents, i) {
+        u64 bytes = sg_dma_len(sg);
+
+        g->mapped_bytes += bytes;
+        g->min_segment_bytes = min(g->min_segment_bytes, bytes);
+        g->max_segment_bytes = max(g->max_segment_bytes, bytes);
+    }
+}
+
+#ifdef TBSTREAM_FAULT_TEST
+/* Test builds: the committed import's geometry, to compare with PREFLIGHT */
+static void sgu_log_import_geometry(struct tbstream_gpu_context *ctx)
+{
+    struct sgu_preflight geometry;
+    u32 d;
+
+    for (d = SGU_DIRECTION_TX; d <= SGU_DIRECTION_RX; ++d) {
+        sgu_window_geometry(&ctx->windows[d], &geometry);
+        pr_info("%s: TEST BUILD import %s geometry: sg_entries %u mapped_bytes %llu min %llu max %llu\n",
+                ctx->sdev->misc.name, d == SGU_DIRECTION_TX ? "tx" : "rx", geometry.sg_entries,
+                geometry.mapped_bytes, geometry.min_segment_bytes, geometry.max_segment_bytes);
+    }
+}
+#else
+static inline void sgu_log_import_geometry(struct tbstream_gpu_context *ctx) { }
+#endif
