 #include "gpu_group_reset.h"
 
+/* PREFLIGHT: one buffer through IMPORT's own mapper/validator, aggregate
+ * geometry out, mapping released before returning. Under sdev->lock. */
+static int sgu_preflight(struct tbstream_dev *sdev, struct tbstream_gpu_context *ctx,
+                         void __user *user)
+{
+    struct sgu_preflight request;
+    struct sgu_window w = {};
+    int ret;
+
+    if (copy_from_user(&request, user, sizeof(request)))
+        return -EFAULT;
+    if (request.fence.abi_major != SGU_ABI_MAJOR || request.fence.abi_minor != SGU_ABI_MINOR ||
+        request.direction > SGU_DIRECTION_RX || request.sg_entries || request.mapped_bytes ||
+        request.min_segment_bytes || request.max_segment_bytes || request.frames ||
+        request.reserved)
+        return -EINVAL;
+    if (tbstream_dev_valid(sdev))
+        return -ENXIO;
+    if (ctx->armed || ctx->started || READ_ONCE(ctx->failed))
+        return -EBUSY;
+    ret = sgu_window_map(ctx, &w, &request.buffer, request.direction);
+    if (ret)
+        return ret;
+    sgu_window_geometry(&w, &request);
+    request.frames = sdev->ring_size;
+    sgu_window_free(&w);
+    return copy_to_user(user, &request, sizeof(request)) ? -EFAULT : 0;
+}
