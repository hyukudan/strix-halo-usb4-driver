+		tbstream_count(&sdev->ctr.rx_canceled, 1);
 		return;
+	}
 
 	if (sf->frame.eof == TBSTREAM_CLOSE && tbstream_fault("rx_damage_close"))
 		sf->frame.flags |= RING_DESC_CRC_ERROR;
+	tbstream_count(&sdev->ctr.rx_completed, 1);
 	sf->completed = true;
 	sdev->rx_ring.prod++;
 	trace_tb_latency(ring, frame, 9, sf->frame.size);
 
 	/* read() fails the stream when it reaches this frame */
 	if (sf->frame.flags & (RING_DESC_CRC_ERROR | RING_DESC_BUFFER_OVERRUN)) {
+		tbstream_count(&sdev->ctr.rx_damaged, 1);
 		pr_warn_ratelimited("%s: RX %s, reads fail from this frame on\n",
 				    sdev->misc.name,
 				    sf->frame.flags & RING_DESC_CRC_ERROR ?
@@ -827,10 +885,11 @@
 {
 	struct device *dma_dev = tb_ring_dma_device(sdev->rx_ring.ring);
 	struct tbstream_frame *sf;
-	int index;
+	int index, ret;
 
 	index = sdev->rx_ring.cons % tb_ring_size(sdev->rx_ring.ring);
 	sdev->rx_ring.cons++;
+	tbstream_count(&sdev->ctr.rx_delivered, 1);
 
 	sf = &sdev->rx_ring.frames[index];
 	sf->completed = false;
@@ -845,9 +904,14 @@
 		list_add_tail(&sf->frame.list, batch);
 		return 0;
 	}
-	if (tbstream_fault("rx_repost"))
-		return -ESHUTDOWN;
