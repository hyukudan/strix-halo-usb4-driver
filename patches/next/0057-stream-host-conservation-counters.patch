 	&tbstream_dev_attr_in_hopid,
 	&tbstream_dev_attr_out_hopid,
 	&tbstream_dev_attr_ring_size,
+	&tbstream_dev_attr_counters,
 	&tbstream_dev_attr_throttling,
 	NULL,
 };
