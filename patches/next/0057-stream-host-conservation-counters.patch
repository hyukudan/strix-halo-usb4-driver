+	/* Per frame: a failed batch of n frames counts n, CLOSE included */
+	if (ret)
+		tbstream_count(&sdev->ctr.rx_repost_failed, n);
+	else
+		tbstream_count(&sdev->ctr.rx_posted, n);
+	return ret;
 }
 
