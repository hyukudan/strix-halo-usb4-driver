 CONFIGFS_ATTR_RO(tbstream_dev_, index);
 
+/* Lockless snapshot: every counter is a single-writer u64 (READ_ONCE) */
+static ssize_t tbstream_dev_counters_show(struct config_item *item, char *buf)
+{
+	struct config_group *group = to_config_group(item);
+	struct tbstream_dev *sdev = tbstream_dev_from_group(group);
+	const struct tbstream_counters *c = &sdev->ctr;
+
+	return sysfs_emit(buf,
+			  "sessions %llu\nrx_posted %llu\nrx_completed %llu\nrx_canceled %llu\nrx_damaged %llu\nrx_delivered %llu\nrx_repost_failed %llu\ntx_posted %llu\ntx_completed %llu\ntx_canceled %llu\nfirst_error %lld\nfirst_error_rx %llu\n",
+			  READ_ONCE(c->sessions), READ_ONCE(c->rx_posted),
+			  READ_ONCE(c->rx_completed), READ_ONCE(c->rx_canceled),
+			  READ_ONCE(c->rx_damaged), READ_ONCE(c->rx_delivered),
+			  READ_ONCE(c->rx_repost_failed), READ_ONCE(c->tx_posted),
+			  READ_ONCE(c->tx_completed), READ_ONCE(c->tx_canceled),
+			  READ_ONCE(c->first_error), READ_ONCE(c->first_error_rx));
+}
+CONFIGFS_ATTR_RO(tbstream_dev_, counters);
+
 static ssize_t tbstream_dev_in_hopid_show(struct config_item *item, char *buf)
 {
