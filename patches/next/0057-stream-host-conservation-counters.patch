+	ret = tbstream_fault("rx_repost") ? -ESHUTDOWN :
+	      tb_ring_rx(sdev->rx_ring.ring, &sf->frame);
+	/* Per frame, CLOSE included; the stream latch is the caller's */
+	if (ret)
+		tbstream_count(&sdev->ctr.rx_repost_failed, 1);
+	else
+		tbstream_count(&sdev->ctr.rx_posted, 1);
+	return ret;
 }
 
 /*
@@ -862,6 +926,10 @@
 	if (!sdev->rx_failed)
 		pr_warn_ratelimited("%s: RX re-post failed (%d), stream failed until close\n",
 				    sdev->misc.name, err);
+	if (!sdev->ctr.first_error) {
