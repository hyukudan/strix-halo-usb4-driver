+/**
+ * tb_ring_snapshot() - Read the state of a ring, for diagnostics
+ * @ring: Ring to read
+ * @snap: Filled with the ring's head and tail, the frames waiting in its
+ *	  queue for a free descriptor and whether the descriptor at the tail
+ *	  is completed (finished by the controller, not collected yet)
+ *
+ * Changes nothing: no descriptor is taken, no frame is posted and no
+ * callback runs. Takes the ring lock, so the caller must not hold a lock
+ * that the ring's callbacks take.
+ */
+void tb_ring_snapshot(struct tb_ring *ring, struct tb_ring_snapshot *snap)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&ring->lock, flags);
+	snap->head = ring->head;
+	snap->tail = ring->tail;
+	snap->queued = list_count_nodes(&ring->queue);
+	snap->front_completed = !ring_empty(ring) &&
+		(ring->descriptors[ring->tail].flags & RING_DESC_COMPLETED);
+	snap->running = ring->running;
+	spin_unlock_irqrestore(&ring->lock, flags);
+}
+EXPORT_SYMBOL_GPL(tb_ring_snapshot);
+
 static void __ring_interrupt_mask(struct tb_ring *ring, bool mask)
 {
 	int idx = ring_interrupt_index(ring);
