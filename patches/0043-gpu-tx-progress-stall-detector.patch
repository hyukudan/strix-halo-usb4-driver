+/* ctx->lock held. Submitted operations of @direction with frames still on
+ * the ring; @oldest (optional) the earliest submitted. A standby RX is
+ * posted but not expected, so it is not pending here. */
+static u32 sgu_stall_pending(struct tbstream_gpu_context *ctx, u32 direction,
+                             struct sgu_hw_operation **oldest)
+{
+    struct sgu_hw_operation *op;
+    u32 slot, n = 0;
+
+    if (oldest)
+        *oldest = NULL;
+    for (slot = 0; slot < ctx->queue_depth; ++slot) {
+        op = &ctx->operations[direction][slot];
+        if (op->phase != SGU_OP_PENDING || !op->remaining)
+            continue;
+        ++n;
+        if (oldest && (!*oldest || op->submitted_ns < (*oldest)->submitted_ns))
+            *oldest = op;
+    }
+    return n;
+}
+
+/* ctx->lock held. Start of the no-progress interval of @direction: the last
+ * frame completed on its ring or, if later, the SUBMIT of the oldest pending
+ * operation (@oldest). 0 when nothing is pending. */
+static u64 sgu_stall_since(struct tbstream_gpu_context *ctx, u32 direction,
+                           struct sgu_hw_operation **oldest)
+{
+    if (!sgu_stall_pending(ctx, direction, oldest))
+        return 0;
+    return max(ctx->progress_ns[direction], (*oldest)->submitted_ns);
+}
+
+/* ctx->lock held: an episode of @direction, without progress since @since,
+ * is seen at @seen_ns. Counted here, once. */
+static void sgu_stall_open(struct tbstream_gpu_context *ctx, u32 direction,
+                           struct sgu_hw_operation *oldest, u64 since, u64 seen_ns)
+{
+    struct sgu_stall *s = &ctx->stall[direction];
+    struct sgu_stall_record *r = &s->last;
+
+    memset(r, 0, sizeof(*r));
+    s->open = true;
+    ++s->episodes;
+    r->sequence = oldest->request.sequence;
+    r->slot = sgu_operation_slot(ctx, oldest);
+    r->start_ns = since;
+    r->seen_ns = seen_ns;
+    r->pending[SGU_DIRECTION_TX] = sgu_stall_pending(ctx, SGU_DIRECTION_TX, NULL);
+    r->pending[SGU_DIRECTION_RX] = sgu_stall_pending(ctx, SGU_DIRECTION_RX, NULL);
+}
+
+/*
+ * ctx->lock held, polled mode: the longest interval between effective
+ * collections during the episode @r of @direction, up to @at. It includes
+ * the time since the last effective collection (from the episode's start if
+ * that is later), so collections that stopped are never hidden.
+ */
+static u64 sgu_stall_gap(const struct tbstream_gpu_context *ctx, u32 direction,
+                         const struct sgu_stall_record *r, u64 at)
+{
+    u64 from = max(ctx->collected_ns, r->start_ns);
+
+    return max(ctx->collect_gap_ns[direction], at > from ? at - from : 0);
+}
+
+/*
+ * Callback context, ctx->lock held, before the frame's operation counts it:
+ * a frame of @direction was completed (reaped at @reap_ns) or canceled. Both
+ * end the interval without progress, and so the open episode. An interval
+ * longer than gpu_stall_ms that no collection point saw is counted here
+ * instead, once, also when it ends by cancellation.
+ */
+static void sgu_stall_progress(struct tbstream_gpu_context *ctx, u32 direction,
+                               bool canceled, u64 reap_ns)
+{
+    u64 threshold = (u64)READ_ONCE(gpu_stall_ms) * NSEC_PER_MSEC, since, end, ns, at;
+    struct sgu_stall *s = &ctx->stall[direction];
+    struct sgu_stall_record *r = &s->last;
+    struct sgu_hw_operation *oldest;
+
+    /* Every collection stamps its batch; a cancellation has no reap. */
+    at = canceled || !reap_ns ? ktime_get_ns() : reap_ns;
+    /* The interval starts at the last completion or later: most frames
+     * need no scan of the operations. */
+    if (!s->open && threshold && at - ctx->progress_ns[direction] > threshold) {
+        since = sgu_stall_since(ctx, direction, &oldest);
+        if (since && at > since && at - since > threshold)
+            sgu_stall_open(ctx, direction, oldest, since, at);
+    }
+    if (s->open) {
+        /* A collection point may have seen it while this batch was reaped. */
+        end = max(at, r->seen_ns);
+        if (ctx->polled)
+            ctx->collect_gap_ns[direction] = sgu_stall_gap(ctx, direction, r, end);
+        ns = end > r->start_ns ? end - r->start_ns : 0;
+        s->open = false;
+        s->total_ns += ns;
+        if (ns > s->max_ns)
+            s->max_ns = ns;
+        r->end_ns = end;
+        r->canceled = canceled;
+        r->collect_gap_ns = ctx->collect_gap_ns[direction];
+    }
+    /* Later frames of a canceled batch start a new interval: no recount. */
+    ctx->progress_ns[direction] = at;
+    ctx->collect_gap_ns[direction] = 0;
+}
+
+/*
+ * A collection point, dma_lock held: counts the episodes that have lasted
+ * more than gpu_stall_ms and reads their ring. @collected: the rings were
+ * just collected (polled mode), which also measures, per pending direction,
+ * the longest interval between collections. Diagnostics only: no operation,
+ * deadline or ring is changed.
+ */
+static void sgu_stall_check(struct tbstream_gpu_context *ctx, bool collected)
+{
+    u64 threshold = (u64)READ_ONCE(gpu_stall_ms) * NSEC_PER_MSEC, seen[2] = { 0, 0 }, now, since;
+    struct sgu_hw_operation *oldest;
+    struct tb_ring_snapshot snap;
+    struct sgu_stall_record *r;
+    unsigned long flags;
+    u32 d;
+
+    lockdep_assert_held(&ctx->dma_lock);
+    if (!threshold)
+        return;
+    spin_lock_irqsave(&ctx->lock, flags);
+    now = ktime_get_ns();
+    for (d = 0; d < 2; ++d) {
+        since = sgu_stall_since(ctx, d, &oldest);
+        if (!since || since >= now)
+            continue;
+        if (collected)
+            ctx->collect_gap_ns[d] = max(ctx->collect_gap_ns[d],
+                                         now - max(ctx->collected_ns, since));
+        if (ctx->stall[d].open || now - since <= threshold)
+            continue;
+        sgu_stall_open(ctx, d, oldest, since, now);
+        seen[d] = now;
+    }
+    if (collected)
+        ctx->collected_ns = now;
+    spin_unlock_irqrestore(&ctx->lock, flags);
+    /* The ring lock is never taken under ctx->lock. */
+    for (d = 0; d < 2; ++d) {
+        if (!seen[d])
+            continue;
+        tb_ring_snapshot(d ? ctx->sdev->rx_ring.ring : ctx->sdev->tx_ring.ring, &snap);
+        spin_lock_irqsave(&ctx->lock, flags);
+        r = &ctx->stall[d].last;
+        if (ctx->stall[d].open && r->seen_ns == seen[d]) {
+            r->snapshot = true;
+            r->head = snap.head;
+            r->tail = snap.tail;
+            r->queued = snap.queued;
+            r->front_completed = snap.front_completed;
+        }
+        spin_unlock_irqrestore(&ctx->lock, flags);
+    }
+}
