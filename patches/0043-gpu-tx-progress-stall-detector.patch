+/*
+ * Stall episodes per direction (diagnostics only). An episode: a submitted
+ * operation of the direction is pending and no frame completed on its ring
+ * for more than gpu_stall_ms. It is counted once, when a collection point
+ * (the EVENT collection, the watchdog) first sees it, or, if none looked
+ * meanwhile, by the completion or cancellation that ends it. It ends at
+ * the next frame completed on that ring, or at its cancellation. The record keeps the last
+ * episode: the oldest pending operation, the pending operations of both
+ * directions and, if a collection point saw it, the ring then.
+ */
+struct sgu_stall_record {
+    u64 sequence, start_ns, seen_ns, end_ns, collect_gap_ns;
+    u32 slot, pending[2], head, tail, queued;
+    bool snapshot, front_completed, canceled;
+};
+struct sgu_stall {
+    u64 episodes, total_ns, max_ns;
+    struct sgu_stall_record last;
+    bool open;
+};
 
