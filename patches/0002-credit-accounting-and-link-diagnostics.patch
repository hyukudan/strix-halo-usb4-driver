diff --git a/drivers/thunderbolt/tunnel.c b/drivers/thunderbolt/tunnel.c
--- a/drivers/thunderbolt/tunnel.c
+++ b/drivers/thunderbolt/tunnel.c
@@ -94,4 +94,26 @@
 static unsigned int dma_credits = TB_DMA_CREDITS;
-module_param(dma_credits, uint, 0644);
-MODULE_PARM_DESC(dma_credits, "specify custom credits for DMA tunnels (default: "
-                __MODULE_STRING(TB_DMA_CREDITS) ")");
+
+static int tb_dma_credits_set(const char *val, const struct kernel_param *kp)
+{
+	unsigned int credits;
+	int ret;
+
+	ret = kstrtouint(val, 0, &credits);
+	if (ret)
+		return ret;
+	if (credits < TB_MIN_DMA_CREDITS || credits > TB_MAX_CREDITS)
+		return -ERANGE;
+
+	/* Existing paths retain their allocated credits until destroyed. */
+	WRITE_ONCE(*(unsigned int *)kp->arg, credits);
+	return 0;
+}
+
+static const struct kernel_param_ops tb_dma_credits_ops = {
+	.set = tb_dma_credits_set,
+	.get = param_get_uint,
+};
+module_param_cb(dma_credits, &tb_dma_credits_ops, &dma_credits, 0644);
+MODULE_PARM_DESC(dma_credits,
+		 "DMA credits for new tunnels, 1..127; not live retuning (default: "
+		 __MODULE_STRING(TB_DMA_CREDITS) ")");
@@ -119,4 +141,7 @@
 static inline unsigned int tb_usable_credits(const struct tb_port *port)
 {
+	/* Do not turn inconsistent firmware values into an unsigned budget. */
+	if (port->total_credits <= port->ctl_credits)
+		return 0;
 	return port->total_credits - port->ctl_credits;
 }
