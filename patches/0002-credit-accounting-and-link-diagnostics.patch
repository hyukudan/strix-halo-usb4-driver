 		/* Add some credits for potential second DMA tunnel */
@@ -161,2 +186,3 @@
-		if (sw->min_dp_aux_credits + sw->min_dp_main_credits)
+		if (credits > usb3 + pcie + spare &&
+		    sw->min_dp_aux_credits + sw->min_dp_main_credits)
 			ndp = (credits - (usb3 + pcie + spare)) /
@@ -1815,4 +1841,14 @@
 	hop = &path->hops[0];
-	tmp = min(tb_usable_credits(hop->in_port), credits);
+	tmp = tb_usable_credits(hop->in_port);
+	if (tb_port_use_credit_allocation(hop->in_port)) {
+		/* USB4NET and multiple streams share this lane adapter. */
+		if (hop->in_port->dma_credits >= tmp)
+			return -ENOSPC;
+		tmp -= hop->in_port->dma_credits;
+	}
+	tmp = min(tmp, credits);
+	if (tmp < TB_MIN_DMA_CREDITS)
+		return -ENOSPC;
 	hop->initial_credits = tmp;
-	hop->in_port->dma_credits += tmp;
+	if (tb_port_use_credit_allocation(hop->in_port))
+		hop->in_port->dma_credits += tmp;
@@ -1935,2 +1971,2 @@
