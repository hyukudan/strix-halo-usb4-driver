+/**
+ * struct tb_ring_stamps - Completion path timestamps of one collection
+ * @irq_ns: Last interrupt of the ring before the collection (0 if none)
+ * @start_ns: The collection started (ring work or a poller)
+ * @reap_ns: Completed descriptors were seen and taken off the ring
+ *
+ * ktime_get_ns() values. While completion callbacks run, &tb_ring.cb_stamps
+ * describes the collection that runs them.
+ */
+struct tb_ring_stamps {
+	u64 irq_ns;
+	u64 start_ns;
+	u64 reap_ns;
+};
