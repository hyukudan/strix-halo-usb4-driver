+/* Completion path timing of the GPU session; any write resets it. */
+static ssize_t tbstream_dev_gpu_timing_show(struct config_item *item, char *buf)
+{
+	struct tbstream_dev *sdev = tbstream_dev_from_group(to_config_group(item));
+
+	guard(mutex)(&sdev->lock);
+	return tbstream_gpu_timing_show(sdev, buf);
+}
+
+static ssize_t tbstream_dev_gpu_timing_store(struct config_item *item,
+					     const char *buf, size_t count)
+{
+	struct tbstream_dev *sdev = tbstream_dev_from_group(to_config_group(item));
+	int ret;
+
+	guard(mutex)(&sdev->lock);
+	ret = tbstream_gpu_timing_reset(sdev);
+	return ret ?: count;
+}
+CONFIGFS_ATTR(tbstream_dev_, gpu_timing);
