 		return -ENXIO;
 	if (sdev->in_hopid <= 0 || sdev->out_hopid <= 0)
@@ -527,6 +533,15 @@ static inline int tbstream_dev_valid(const struct tbstream_dev *sdev)
 	return 0;
 }
 
+/*
+ * Lockless: whether a stream is attached, never a dereference of it. For the
+ * unlocked paths and wait conditions; the locked loops then validate it.
+ */
+static inline bool tbstream_dev_attached(const struct tbstream_dev *sdev)
+{
+	return READ_ONCE(sdev->stream) != NULL;
+}
