+/*
+ * Looks inside the attached stream: only with sdev->lock held. Detach clears
+ * sdev->stream and drops its reference under that lock, and an open file
+ * keeps the device alive, not the stream.
+ */
 static inline int tbstream_dev_valid(const struct tbstream_dev *sdev)
 {
 	const struct tbstream *stream = sdev->stream;
 
+	lockdep_assert_held(&sdev->lock);
