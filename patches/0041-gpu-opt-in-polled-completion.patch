+/**
+ * tb_ring_collect() - Complete the finished frames of a polled ring
+ * @ring: Ring allocated with %RING_FLAG_NO_INTERRUPT
+ * @budget: Complete at most this many frames
+ *
+ * Does for a ring without interrupt what the ring work does after an
+ * interrupt: takes the completed descriptors in order, posts queued frames
+ * into the slots they free (nothing else would: the ring work is not queued
+ * for such a ring while it runs) and then calls the callbacks outside the
+ * ring lock, each exactly once and never as canceled. The caller serializes
+ * its collections with tb_ring_stop() of the ring: once stop returns, the
+ * frames it canceled were not collected, but a callback of a collection
+ * still running would not be covered by its flush.
+ *
+ * Return: Number of frames completed.
+ */
+unsigned int tb_ring_collect(struct tb_ring *ring, unsigned int budget)
+{
+	u64 start = ktime_get_ns(), elapsed;
+	struct ring_frame *frame;
+	unsigned long flags;
+	unsigned int n = 0;
+	LIST_HEAD(done);
+
+	if (WARN_ON_ONCE(!(ring->flags & RING_FLAG_NO_INTERRUPT)))
+		return 0;
+	spin_lock_irqsave(&ring->lock, flags);
+	ring->polls++;
+	if (!ring->running) {
+		spin_unlock_irqrestore(&ring->lock, flags);
+		return 0;
+	}
+	while (n < budget && !ring_empty(ring) &&
+	       (ring->descriptors[ring->tail].flags & RING_DESC_COMPLETED)) {
+		frame = list_first_entry(&ring->in_flight, typeof(*frame), list);
+		list_move_tail(&frame->list, &done);
+		if (!ring->is_tx) {
+			frame->size = ring->descriptors[ring->tail].length;
+			frame->eof = ring->descriptors[ring->tail].eof;
+			frame->sof = ring->descriptors[ring->tail].sof;
+			frame->flags = ring->descriptors[ring->tail].flags;
+		}
+		ring->tail = (ring->tail + 1) % ring->size;
+		n++;
+	}
+	if (n) {
+		ring->cb_stamps.irq_ns = 0;
+		ring->cb_stamps.start_ns = start;
+		ring->cb_stamps.reap_ns = ktime_get_ns();
+	}
+	ring_write_descriptors(ring);
+	spin_unlock_irqrestore(&ring->lock, flags);
+
+	while (!list_empty(&done)) {
+		frame = list_first_entry(&done, typeof(*frame), list);
+		list_del_init(&frame->list);
+		if (frame->callback)
+			frame->callback(ring, frame, false);
+	}
+	if (n) {
+		elapsed = ktime_get_ns() - start;
+		spin_lock_irqsave(&ring->lock, flags);
+		ring->collections++;
+		ring->collect_ns_total += elapsed;
+		if (elapsed > ring->collect_ns_max)
+			ring->collect_ns_max = elapsed;
+		spin_unlock_irqrestore(&ring->lock, flags);
+	}
+	return n;
+}
+EXPORT_SYMBOL_GPL(tb_ring_collect);
