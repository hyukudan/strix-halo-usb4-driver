+/*
+ * Polled mode: complete what the controller finished on both rings. Under
+ * dma_lock, which STOP holds while it stops the rings and joins their work:
+ * no collected callback is still running once a stop returns, and the frames
+ * the stop cancels were not collected. The callbacks are the interrupt
+ * path's (terminal check, FINISHING -> fence -> EVENT), each exactly once.
+ */
+static unsigned int sgu_collect_locked(struct tbstream_gpu_context *ctx)
+{
+    struct tbstream_dev *sdev = ctx->sdev;
+    unsigned int budget = clamp_val(READ_ONCE(gpu_poll_budget), 1, 4096), n;
+    bool cookie;
+
+    lockdep_assert_held(&ctx->dma_lock);
+    if (!ctx->polled || !ctx->started || ctx->stopped || READ_ONCE(ctx->closing))
+        return 0;
+    cookie = dma_fence_begin_signalling();
+    n = tb_ring_collect(sdev->tx_ring.ring, budget);
+    n += tb_ring_collect(sdev->rx_ring.ring, budget);
+    dma_fence_end_signalling(cookie);
+    ++ctx->polls;
+    ctx->polled_frames += n;
+    return n;
+}
+
+/* EVENT never waits for dma_lock: a holder (enqueue, watchdog, STOP) is
+ * already making progress or stopping. */
+static void sgu_collect(struct tbstream_gpu_context *ctx)
+{
+    if (!ctx->polled || !mutex_trylock(&ctx->dma_lock))
+        return;
+    sgu_collect_locked(ctx);
+    mutex_unlock(&ctx->dma_lock);
+}
+
+static unsigned long sgu_watchdog_delay(struct tbstream_gpu_context *ctx)
+{
+    return msecs_to_jiffies(ctx->polled ?
+                            clamp_val(READ_ONCE(gpu_poll_fallback_ms), 1, 100) : 100);
+}
