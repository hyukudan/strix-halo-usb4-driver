+/**
+ * tb_nhi_data_rings_idle() - Whether no data ring is allocated on @nhi
+ * @nhi: Host interface
+ *
+ * Return: %true when only the control ring is allocated.
+ */
+bool tb_nhi_data_rings_idle(struct tb_nhi *nhi)
+{
+	unsigned long flags;
+	bool idle;
+
+	spin_lock_irqsave(&nhi->lock, flags);
+	idle = nhi_data_rings_freed(nhi);
+	spin_unlock_irqrestore(&nhi->lock, flags);
+	return idle;
+}
