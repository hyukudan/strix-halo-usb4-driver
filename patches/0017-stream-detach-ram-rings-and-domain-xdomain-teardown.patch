diff --git a/drivers/thunderbolt/tb.c b/drivers/thunderbolt/tb.c
--- a/drivers/thunderbolt/tb.c
+++ b/drivers/thunderbolt/tb.c
@@ -2940,6 +2940,41 @@ static void tb_handle_event(struct tb *tb, enum tb_cfg_pkg_type type,
 	tb_queue_hotplug(tb, route, pkg->port, pkg->unplug);
 }
 
+static void tb_remove_switch_xdomains(struct tb_switch *sw)
+{
+	struct tb_port *port;
+
+	tb_switch_for_each_port(sw, port) {
+		if (tb_port_has_remote(port)) {
+			tb_remove_switch_xdomains(port->remote->sw);
+		} else if (port->xdomain) {
+			/* As tb_switch_remove() would, one step earlier */
+			port->xdomain->is_unplugged = true;
+			tb_xdomain_remove(port->xdomain);
+			port->xdomain = NULL;
+		}
+	}
+}
+
+/*
+ * Domain removal, before tb_stop(). tb_switch_remove() only marks the
+ * XDomains it finds unplugged, and nothing unregisters them afterwards:
+ * they and their services stay registered after the domain, and even the
+ * module, are gone (a later device_shutdown() calls through their stale
+ * bus). Removing them here, while their routers exist, lets the domain
+ * unregister them without tb->lock, as the hotplug path does, so service
+ * drivers stop their rings before tb_stop() deactivates the DMA paths.
+ */
+static void tb_remove_xdomains(struct tb *tb)
+{
+	struct tb_cm *tcm = tb_priv(tb);
+
+	/* No new XDomain from now on */
+	tcm->hotplug_active = false;
+	if (tb->root_switch)
+		tb_remove_switch_xdomains(tb->root_switch);
+}
+
 static void tb_stop(struct tb *tb)
 {
 	struct tb_cm *tcm = tb_priv(tb);
@@ -3315,6 +3350,7 @@ static int tb_runtime_resume(struct tb *tb)
 
