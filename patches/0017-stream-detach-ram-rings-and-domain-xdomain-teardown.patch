+struct tb_xdomain_unregister_work {
+	struct work_struct work;
+	struct tb *tb;
+};
+
+static void tb_domain_unregister_xdomains_work(struct work_struct *work)
+{
+	struct tb_xdomain_unregister_work *w = container_of(work, typeof(*w), work);
+
+	tb_domain_unregister_unplugged_xdomains(w->tb);
+}
+
+/*
+ * The hotplug handler unregisters unplugged XDomains from the domain's
+ * ordered workqueue as well. Running there too means the two never
+ * unregister the same XDomain twice.
+ */
+static void tb_domain_unregister_xdomains_sync(struct tb *tb)
+{
+	struct tb_xdomain_unregister_work w = { .tb = tb };
+
+	INIT_WORK_ONSTACK(&w.work, tb_domain_unregister_xdomains_work);
+	queue_work(tb->wq, &w.work);
+	flush_work(&w.work);
+	destroy_work_on_stack(&w.work);
+}
