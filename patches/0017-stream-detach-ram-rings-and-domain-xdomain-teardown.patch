+/*
+ * v1 host interfaces have no host router reset (HRR). The quirked ones get
+ * a host interface reset instead: ring registers and E2E state back to
+ * their defaults, not the router or its hop tables. Nothing has started
+ * yet at probe, so no ring of another user is lost here.
+ */
+static void nhi_reset_interface(struct tb_nhi *nhi)
+{
+	if (!(nhi->quirks & QUIRK_RESET_INTERFACE_ON_PROBE))
+		return;
