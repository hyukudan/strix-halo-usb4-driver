  * tb_domain_remove() - Removes and releases a domain
  * @tb: Domain to remove
@@ -572,6 +599,17 @@ void tb_domain_remove(struct tb *tb)
 	spin_lock_irq(&tb->nhi->lock);
 	tb->nhi->dma_shutdown = true;
 	spin_unlock_irq(&tb->nhi->lock);
+	if (tb->cm_ops->remove_xdomains) {
+		/*
+		 * Unbind the service drivers while the routers and the DMA
+		 * paths still exist: they stop their rings before the CM
+		 * deactivates the paths, and no service outlives the domain.
+		 */
+		tb->cm_ops->remove_xdomains(tb);
+		mutex_unlock(&tb->lock);
+		tb_domain_unregister_xdomains_sync(tb);
+		mutex_lock(&tb->lock);
+	}
