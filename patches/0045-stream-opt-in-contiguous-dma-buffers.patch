+static void tbstream_ring_free_chunks(struct tbstream_ring *ring,
+				      enum dma_data_direction dir)
+{
+	struct device *dma_dev = tb_ring_dma_device(ring->ring);
+	unsigned int c;
+
+	for (c = 0; c < ring->chunks; c++) {
+		dma_unmap_page(dma_dev, ring->chunk_dma[c],
+			       PAGE_SIZE << ring->chunk_order, dir);
+		__free_pages(ring->chunk[c], ring->chunk_order);
+		ring->chunk[c] = NULL;
+		ring->chunk_dma[c] = 0;
+	}
+	ring->chunks = 0;
+}
+
+/*
+ * Frame buffers carved from physically contiguous blocks (naturally
+ * aligned, at most 2 MiB), each block mapped once: one IOVA range per
+ * block instead of one per 4 KiB frame, which a translating IOMMU can map
+ * with large pages. Sets every frame's page and DMA address and returns 0,
+ * or releases what it took and returns -ENOMEM (the caller then uses one
+ * page per frame). A frame stays one page: the copies and the partial
+ * syncs of a frame are unchanged.
+ */
+static int tbstream_ring_alloc_chunks(struct tbstream_ring *ring,
+				      enum dma_data_direction dir)
+{
+	struct device *dma_dev = tb_ring_dma_device(ring->ring);
+	size_t ring_size = tb_ring_size(ring->ring), i;
+	unsigned int order, per_chunk, n, c;
+
+	BUILD_BUG_ON(TB_MAX_FRAME_SIZE != PAGE_SIZE);
+	order = min_t(unsigned int, get_order(ring_size * PAGE_SIZE),
+		      TBSTREAM_DEV_CHUNK_MAX_ORDER);
+	per_chunk = 1U << order;
+	n = DIV_ROUND_UP(ring_size, per_chunk);
+	if (n > TBSTREAM_DEV_MAX_CHUNKS)
+		return -EINVAL;
+	ring->chunk_order = order;
+	for (c = 0; c < n; c++) {
+		struct page *page;
+		dma_addr_t dma;
+
+		page = alloc_pages(GFP_KERNEL | __GFP_NOWARN | __GFP_NORETRY, order);
+		if (!page)
+			goto fail;
+		dma = dma_map_page(dma_dev, page, 0, PAGE_SIZE << order, dir);
+		if (dma_mapping_error(dma_dev, dma)) {
+			__free_pages(page, order);
+			goto fail;
+		}
+		ring->chunk[c] = page;
+		ring->chunk_dma[c] = dma;
+		ring->chunks = c + 1;
+	}
+	for (i = 0; i < ring_size; i++) {
+		struct tbstream_frame *sf = &ring->frames[i];
+
+		sf->page = ring->chunk[i / per_chunk] + i % per_chunk;
+		sf->frame.buffer_phy = ring->chunk_dma[i / per_chunk] +
+				       (dma_addr_t)(i % per_chunk) * PAGE_SIZE;
+	}
+	return 0;
+
+fail:
+	tbstream_ring_free_chunks(ring, dir);
+	return -ENOMEM;
+}
