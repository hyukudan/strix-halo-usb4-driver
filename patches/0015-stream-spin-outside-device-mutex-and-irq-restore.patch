+/*
+ * Reap once without spinning. Called with sdev->lock held. If another
+ * reader is spinning it owns rx_lock and is reaping already.
+ */
+static void tbstream_dev_napi_rx(struct tbstream_dev *sdev)
+{
+	if (!sdev->rx_napi || !mutex_trylock(&sdev->rx_lock))
+		return;
+	tbstream_dev_napi_rx_locked(sdev, false);
+	mutex_unlock(&sdev->rx_lock);
+}
+
+/*
+ * Bounded busy-poll before a blocking reader sleeps, without the device
+ * mutex (up to spin_us, at most TBSTREAM_DEV_MAX_SPIN_US). Returns %true
+ * if RX frames became available; the caller re-checks under sdev->lock.
+ * The caller holds an open file, so the rings exist unless a system
+ * suspend stopped them, which tbstream_dev_stop() does under rx_lock.
+ */
+static bool tbstream_dev_napi_spin(struct tbstream_dev *sdev)
+{
+	bool available;
+
+	if (!READ_ONCE(sdev->rx_napi) || !READ_ONCE(sdev->rx_spin_us))
+		return false;
+	if (mutex_lock_interruptible(&sdev->rx_lock))
+		return false;
+	tbstream_dev_napi_rx_locked(sdev, true);
+	available = sdev->rx_ring.ring && tbstream_ring_available(&sdev->rx_ring);
+	mutex_unlock(&sdev->rx_lock);
+	return available;
+}
+
 /*
  * Ring vectors are requested when a stream is opened, so their CPU is
  * chosen afresh every time. Keeping the completion interrupt next to the
  * thread that consumes it avoids cross-CCD wake-ups, which dominate the
  * latency tail on Strix Halo. Best effort: a failure only loses the hint.
+ * The previous affinity is restored when the stream stops, because the
+ * Linux IRQ of an MSI-X vector is reused by the next ring (USB4NET, another
+ * stream). irqbalance may still move a pinned vector: ban these IRQs there
+ * (IRQBALANCE_BANNED_CPULIST or --banirq) if the placement must hold.
  */
+static void tbstream_dev_irq_pin(struct tbstream_dev *sdev, int slot,
+				 struct tb_ring *ring, int cpu)
+{
+	const struct cpumask *previous;
+	int irq = ring ? ring->irq : 0;
+	int ret;
+
+	if (irq <= 0 || sdev->irq_pinned[slot])
+		return;
+	previous = irq_get_affinity_mask(irq);
+	if (!previous)
+		return;
+	cpumask_copy(sdev->irq_saved[slot], previous);
+	ret = irq_set_affinity(irq, cpumask_of(cpu));
+	if (ret) {
+		pr_info_ratelimited("%s: IRQ %d stays on its CPU, irq_cpu %d failed: %d\n",
+				    sdev->misc.name, irq, cpu, ret);
+		return;
+	}
+	sdev->irq_pinned[slot] = irq;
+}
+
 static void tbstream_dev_irq_affinity(struct tbstream_dev *sdev)
 {
 	int cpu = READ_ONCE(sdev->irq_cpu);
 
-	if (cpu < 0 || cpu >= nr_cpu_ids || !cpu_online(cpu))
+	if (cpu < 0)
 		return;
-	if (sdev->tx_ring.ring && sdev->tx_ring.ring->irq > 0)
-		irq_set_affinity(sdev->tx_ring.ring->irq, cpumask_of(cpu));
-	if (sdev->rx_ring.ring && sdev->rx_ring.ring->irq > 0)
-		irq_set_affinity(sdev->rx_ring.ring->irq, cpumask_of(cpu));
+	if (cpu >= nr_cpu_ids || !cpu_online(cpu)) {
+		pr_info_ratelimited("%s: irq_cpu %d is offline, IRQ placement unchanged\n",
+				    sdev->misc.name, cpu);
+		return;
+	}
+	tbstream_dev_irq_pin(sdev, 0, sdev->tx_ring.ring, cpu);
+	tbstream_dev_irq_pin(sdev, 1, sdev->rx_ring.ring, cpu);
+}
+
+/* Before the rings (and with them the IRQs) are freed. */
+static void tbstream_dev_irq_affinity_restore(struct tbstream_dev *sdev)
+{
+	int slot;
+
+	for (slot = 0; slot < 2; slot++) {
+		if (!sdev->irq_pinned[slot])
+			continue;
+		irq_set_affinity(sdev->irq_pinned[slot], sdev->irq_saved[slot]);
+		sdev->irq_pinned[slot] = 0;
+	}
 }
 
