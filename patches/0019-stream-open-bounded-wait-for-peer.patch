+#define TBSTREAM_DEV_MAX_OPEN_TIMEOUT_MS	600000
+
+static unsigned int open_timeout_ms = 30000;
+module_param(open_timeout_ms, uint, 0644);
+MODULE_PARM_DESC(open_timeout_ms,
+		 "How long open() waits for the peer's stream service when its XDomain is connected, in ms, at most 600000 (default: 30000)");
+
+static unsigned int tbstream_dev_open_timeout(const struct tbstream_dev *sdev)
+{
+	int ms = READ_ONCE(sdev->cfg_open_timeout_ms);
+
+	if (ms < 0)
+		return min_t(unsigned int, READ_ONCE(open_timeout_ms),
+			     TBSTREAM_DEV_MAX_OPEN_TIMEOUT_MS);
+	return ms;
+}
+
+/*
+ * No stream is attached, or its XDomain is going away. A connection whose
+ * domain is gone (-ENODEV) or whose XDomain is absent (-ENXIO) cannot come
+ * back while we wait: fail at once. Otherwise the XDomain is there and its
+ * stream service may still appear: -EAGAIN when non-blocking, else wait
+ * interruptibly until @deadline (-ETIMEDOUT), re-checking the XDomain at
+ * least once a second. Called and returns without sdev->lock.
+ */
+static int tbstream_dev_wait_stream(struct tbstream_dev *sdev, bool nonblock,
+				    unsigned long deadline)
+{
+	long remaining;
+	int ret;
+
+	ret = tb_xdomain_presence(sdev->domain_index, sdev->route);
+	if (ret)
+		return ret;
+	if (nonblock)
+		return -EAGAIN;
+	remaining = (long)(deadline - jiffies);
+	if (remaining <= 0)
+		return -ETIMEDOUT;
+
+	ret = wait_event_interruptible_timeout(sdev->wait,
+			tbstream_dev_valid(sdev) == 0 ||
+			tbstream_dev_removed(sdev),
+			min_t(long, remaining, HZ));
+	if (ret < 0)
+		return ret;
+	if (tbstream_dev_removed(sdev))
+		return -ENXIO;
+	return 0;
+}
