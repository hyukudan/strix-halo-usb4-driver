diff --git a/drivers/thunderbolt/xdomain.c b/drivers/thunderbolt/xdomain.c
--- a/drivers/thunderbolt/xdomain.c
+++ b/drivers/thunderbolt/xdomain.c
@@ -2612,6 +2612,43 @@ struct tb_xdomain *tb_xdomain_find_by_route(struct tb *tb, u64 route)
 }
 EXPORT_SYMBOL_GPL(tb_xdomain_find_by_route);
 
+/**
+ * tb_xdomain_presence() - Whether an XDomain connection exists right now
+ * @domain: Domain index
+ * @route: Route string of the XDomain in that domain
+ *
+ * For service drivers that wait for a connection by name (configfs), so
+ * that they do not wait for one whose domain is gone or whose cable is
+ * not there. Lookup by name on the bus: needs no domain reference.
+ *
+ * Return: %0 if the XDomain is registered and not unplugged, %-ENXIO if
+ * the domain exists but that XDomain does not (or is going away),
+ * %-ENODEV if the domain itself does not exist.
+ */
+int tb_xdomain_presence(unsigned int domain, u64 route)
+{
+	struct device *dev;
+	char name[32];
+	int ret = -ENXIO;
+
+	snprintf(name, sizeof(name), "domain%u", domain);
+	dev = bus_find_device_by_name(&tb_bus_type, NULL, name);
+	if (!dev)
+		return -ENODEV;
+	put_device(dev);
+
+	/* Routers use the same name format: only an XDomain counts */
+	snprintf(name, sizeof(name), "%u-%llx", domain, route);
+	dev = bus_find_device_by_name(&tb_bus_type, NULL, name);
+	if (!dev)
+		return -ENXIO;
+	if (tb_is_xdomain(dev) && !READ_ONCE(tb_to_xdomain(dev)->is_unplugged))
+		ret = 0;
+	put_device(dev);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(tb_xdomain_presence);
+
