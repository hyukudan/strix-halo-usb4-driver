diff --git a/drivers/thunderbolt/gpu_stream.c b/drivers/thunderbolt/gpu_stream.c
--- a/drivers/thunderbolt/gpu_stream.c
+++ b/drivers/thunderbolt/gpu_stream.c
@@ -1804,8 +1804,16 @@ static long tbstream_gpu_ioctl(struct file *file, unsigned int command, unsigned
 
     if (command == SGU_IOC_RESET_GROUP)
         return sgu_reset_group_ioctl(file, user);
-    if (mutex_lock_interruptible(&sdev->lock))
+    /* SGU_CAP_NONBLOCK_SUBMIT: a non-blocking publication does not sleep on
+     * the device mutex either, which another ioctl or the data path can hold
+     * for long. Other commands keep their blocking semantics. */
+    if ((file->f_flags & O_NONBLOCK) &&
+        (command == SGU_IOC_SUBMIT || command == SGU_IOC_RX_REPOST)) {
+        if (!mutex_trylock(&sdev->lock))
+            return -EAGAIN;
+    } else if (mutex_lock_interruptible(&sdev->lock)) {
         return -ERESTARTSYS;
+    }
     ctx = sdev->gpu_context;
     if (!ctx) {
         ret = -ENXIO;
