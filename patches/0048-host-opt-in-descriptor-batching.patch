+/* Zero preserves the legacy path. Experimental, host-only, closed streams. */
+static ssize_t tbstream_dev_rx_repost_batch_show(struct config_item *item, char *buf)
+{
+	struct tbstream_dev *sdev = tbstream_dev_from_group(to_config_group(item));
+
+	return sysfs_emit(buf, "%u\n", sdev->rx_repost_batch);
+}
+
+static ssize_t tbstream_dev_rx_repost_batch_store(struct config_item *item,
+					      const char *buf, size_t count)
+{
+	struct tbstream_dev *sdev = tbstream_dev_from_group(to_config_group(item));
+	unsigned int value;
+	int ret = kstrtouint(buf, 0, &value);
+
+	if (ret)
+		return ret;
+	if (value > 64)
+		return -ERANGE;
+	guard(mutex)(&sdev->lock);
+	if (tbstream_dev_config_busy(sdev))
+		return -EBUSY;
+#if IS_ENABLED(CONFIG_USB4_GPU_STREAM)
+	if (value && sdev->gpu_direct)
+		return -EOPNOTSUPP;
+#endif
+	sdev->rx_repost_batch = value;
+	return count;
+}
+CONFIGFS_ATTR(tbstream_dev_, rx_repost_batch);
