+/* Caller holds sdev->lock. Never wait for a full batch or more credits. */
+static ssize_t tbstream_dev_send_data_batch(struct tbstream_dev *sdev,
+					  struct iov_iter *from)
+{
+	LIST_HEAD(batch);
+	size_t bytes = 0;
+	unsigned int count = 0;
+	int ret = 0;
+
+	while (iov_iter_count(from) && count < sdev->tx_submit_batch) {
+		struct tbstream_frame *sf;
+		size_t size = min(iov_iter_count(from), TB_MAX_FRAME_SIZE);
+
+		sf = tbstream_dev_alloc_tx(sdev, TBSTREAM_DATA, from, size);
+		if (IS_ERR(sf)) {
+			ret = PTR_ERR(sf);
+			break;
+		}
+		list_add_tail(&sf->frame.list, &batch);
+		bytes += size;
+		count++;
+	}
+	if (!count)
+		return ret;
+
+	/* A later copy fault does not discard the complete prefix. */
+	ret = tbstream_dev_submit_batch(sdev->tx_ring.ring, &batch);
+	if (ret) {
+		iov_iter_revert(from, bytes);
+		sdev->tx_ring.cons -= count;
+		return ret;
+	}
+	return bytes;
 }
 
