+#define TBSTREAM_TX_COPY_CACHED		0	/* copy_page_from_iter() */
+#define TBSTREAM_TX_COPY_NOCACHE	1	/* non-temporal stores, edges written back */
+#define TBSTREAM_TX_COPY_CLWB		2	/* copy, then write the lines back (kept clean) */
+#define TBSTREAM_TX_COPY_FLUSH		3	/* copy, then write back and evict the lines */
+#define TBSTREAM_TX_COPY_MAX		TBSTREAM_TX_COPY_FLUSH
+
+static int tx_copy_set(const char *value, const struct kernel_param *kp)
+{
+	unsigned int mode;
+	int ret;
+
+	ret = kstrtouint(value, 0, &mode);
+	if (ret)
+		return ret;
+	if (mode > TBSTREAM_TX_COPY_MAX)
+		return -EINVAL;
+	return param_set_uint(value, kp);
+}
+
+static const struct kernel_param_ops tx_copy_ops = {
+	.set = tx_copy_set,
+	.get = param_get_uint,
+};
