+
+static size_t tbstream_tx_fill(struct tbstream_dev *sdev, struct tbstream_frame *sf,
+			       size_t size, struct iov_iter *from)
+{
+	void *buf = page_address(sf->page);
+	size_t copied;
+
+	switch (sdev->tx_copy) {
+	case TBSTREAM_TX_COPY_NOCACHE:
+		copied = _copy_from_iter_flushcache(buf, size, from);
+		/* Non-temporal stores are weakly ordered: drain them before the doorbell */
+		wmb();
+		return copied;
+#ifdef CONFIG_X86
+	case TBSTREAM_TX_COPY_CLWB:
+		copied = copy_page_from_iter(sf->page, 0, size, from);
+		arch_wb_cache_pmem(buf, copied);
+		return copied;
+	case TBSTREAM_TX_COPY_FLUSH:
+		copied = copy_page_from_iter(sf->page, 0, size, from);
+		clflush_cache_range(buf, copied);
+		return copied;
+#endif
+	default:
+		return copy_page_from_iter(sf->page, 0, size, from);
+	}
