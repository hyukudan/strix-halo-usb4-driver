+
+#define TBSTREAM_TX_FRAME_MIN		256
+
+static int tx_frame_bytes_set(const char *value, const struct kernel_param *kp)
+{
+	unsigned int bytes;
+	int ret;
+
+	ret = kstrtouint(value, 0, &bytes);
+	if (ret)
+		return ret;
+	if (bytes && (bytes < TBSTREAM_TX_FRAME_MIN || bytes > TB_MAX_FRAME_SIZE ||
+		      bytes % 64))
+		return -EINVAL;
+	return param_set_uint(value, kp);
