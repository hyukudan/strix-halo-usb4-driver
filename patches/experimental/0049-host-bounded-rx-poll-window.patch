+static ssize_t tbstream_dev_rx_window_bytes_show(struct config_item *item, char *buf)
+{
+	struct tbstream_dev *sdev = tbstream_dev_from_group(to_config_group(item));
+
+	return sysfs_emit(buf, "%u\n", sdev->rx_window_bytes);
+}
+
+static ssize_t tbstream_dev_rx_window_bytes_store(struct config_item *item,
+		const char *buf, size_t count)
+{
+	struct tbstream_dev *sdev = tbstream_dev_from_group(to_config_group(item));
+	unsigned int value;
+	int ret = kstrtouint(buf, 0, &value);
+
+	if (ret)
+		return ret;
+	if (value > 1048576)
+		return -EINVAL;
+	guard(mutex)(&sdev->lock);
+	if (tbstream_dev_config_busy(sdev))
+		return -EBUSY;
+	if (value && (sdev->busy_poll || sdev->rx_busy_poll))
+		return -EOPNOTSUPP;
+#if IS_ENABLED(CONFIG_USB4_GPU_STREAM)
+	if (value && sdev->gpu_direct)
+		return -EOPNOTSUPP;
+#endif
+	/* Batch budgets are a separate opt-in: clear them first. */
+	if (value && (sdev->rx_repost_batch || sdev->tx_submit_batch))
+		return -EBUSY;
+	sdev->rx_window_bytes = value;
+	return count;
+}
+CONFIGFS_ATTR(tbstream_dev_, rx_window_bytes);
