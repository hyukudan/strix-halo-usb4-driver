+
+/**
+ * tb_ring_poll_begin() - Temporarily mask an IRQ-driven RX NAPI ring
+ * @ring: Running RX ring with start_poll, whose lifetime the caller owns
+ *
+ * The owner must call tb_ring_poll_end() or stop the ring. No descriptors,
+ * callbacks or NO_INTERRUPT flags change. poll_complete cannot end this lease.
+ */
+int tb_ring_poll_begin(struct tb_ring *ring)
+{
+	unsigned long flags;
+	int ret = 0;
+
+	spin_lock_irqsave(&ring->nhi->lock, flags);
+	spin_lock(&ring->lock);
+	if (ring->nhi->going_away || !ring->running)
+		ret = -ENODEV;
+	else if (ring->is_tx || !ring->start_poll ||
+		 (ring->flags & RING_FLAG_NO_INTERRUPT))
+		ret = -EOPNOTSUPP;
+	else if (ring->poll_window)
+		ret = -EBUSY;
+	else {
+		ring->poll_window = true;
+		__ring_interrupt_mask(ring, true);
+	}
+	spin_unlock(&ring->lock);
+	spin_unlock_irqrestore(&ring->nhi->lock, flags);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(tb_ring_poll_begin);
+
+/**
+ * tb_ring_poll_end() - End a temporary RX polling lease, if any
+ * @ring: Ring whose lifetime the caller owns
+ *
+ * Pending completions are retained. Re-enabling the interrupt lets the normal
+ * start_poll callback wake the reader. Safe after stop, before ring_free.
+ */
+void tb_ring_poll_end(struct tb_ring *ring)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&ring->nhi->lock, flags);
+	spin_lock(&ring->lock);
+	if (ring->poll_window) {
+		ring->poll_window = false;
+		if (ring->running && !ring->nhi->going_away && ring->start_poll)
+			__ring_interrupt_mask(ring, false);
+	}
+	spin_unlock(&ring->lock);
+	spin_unlock_irqrestore(&ring->nhi->lock, flags);
+}
+EXPORT_SYMBOL_GPL(tb_ring_poll_end);
+
 
