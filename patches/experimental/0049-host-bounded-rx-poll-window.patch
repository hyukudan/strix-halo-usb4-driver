diff --git a/include/uapi/linux/strix_host_stream.h b/include/uapi/linux/strix_host_stream.h
new file mode 100644
--- /dev/null
+++ b/include/uapi/linux/strix_host_stream.h
@@ -0,0 +1,17 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+/* Project-owned host-only experimental ABI; no wire-format change. */
+#ifndef STRIX_HOST_STREAM_H
+#define STRIX_HOST_STREAM_H
+#include <linux/ioctl.h>
+#include <linux/types.h>
+
+/* Fixed-width/aligned on 32/64-bit userspace; reserved fields must be zero. */
+struct shs_rx_window {
+	__u64 cookie;        /* Nonzero, unique for this fd's exchange. */
+	__u64 bytes;         /* Full logical RX exchange, including its header. */
+	__u32 flags;
+	__u32 reserved;
+};
+#define SHS_RX_WINDOW_BEGIN _IOW('H', 0xe0, struct shs_rx_window)
+#define SHS_RX_WINDOW_END   _IOW('H', 0xe1, struct shs_rx_window)
+#endif
