+/* sdev->lock serializes BEGIN/END/stop. The timer takes only window_lock,
+ * then the core's NHI/ring locks; the IRQ callback never takes window_lock.
+ * Cancel synchronously outside window_lock before releasing any ring lifetime.
+ */
+static void tbstream_dev_window_stop(struct tbstream_dev *sdev)
+{
+	unsigned long flags;
+
+	hrtimer_cancel(&sdev->window_timer);
+	spin_lock_irqsave(&sdev->window_lock, flags);
+	if (sdev->window_active) {
+		WRITE_ONCE(sdev->window_active, false);
+		tb_ring_poll_end(sdev->rx_ring.ring);
+	}
+	spin_unlock_irqrestore(&sdev->window_lock, flags);
+	wake_up_interruptible(&sdev->wait);
+}
+
+static enum hrtimer_restart tbstream_dev_window_expire(struct hrtimer *timer)
+{
+	struct tbstream_dev *sdev = container_of(timer, struct tbstream_dev, window_timer);
+	unsigned long flags;
+	enum hrtimer_restart ret = HRTIMER_NORESTART;
+
+	spin_lock_irqsave(&sdev->window_lock, flags);
+	if (sdev->window_active) {
+		if (ktime_before(ktime_get(), sdev->window_deadline)) {
+			hrtimer_set_expires(timer, sdev->window_deadline);
+			ret = HRTIMER_RESTART;
+		} else {
+			WRITE_ONCE(sdev->window_active, false);
+			tb_ring_poll_end(sdev->rx_ring.ring);
+		}
+	}
+	spin_unlock_irqrestore(&sdev->window_lock, flags);
+	wake_up_interruptible(&sdev->wait);
+	return ret;
+}
+
+static int tbstream_dev_window_command(struct tbstream_dev *sdev,
+		unsigned int command, const struct shs_rx_window *hint)
+{
+	unsigned long flags;
+	int ret = 0;
+
+	lockdep_assert_held(&sdev->lock);
+	if (hint->flags || hint->reserved || !hint->cookie)
+		return -EINVAL;
+	if (!sdev->rx_window_bytes)
+		return -EOPNOTSUPP;
+	if (!sdev->rx_ring.ring || sdev->detached || sdev->removed || sdev->closed)
+		return -ENODEV;
+	if (command == SHS_RX_WINDOW_END) {
+		if (hint->cookie != sdev->window_cookie)
+			return -ESTALE;
+		tbstream_dev_window_stop(sdev);
+		return 0;
+	}
+	if (command != SHS_RX_WINDOW_BEGIN || !hint->bytes)
+		return -EINVAL;
+	if (READ_ONCE(sdev->window_active))
+		return -EBUSY;
+	/* Join a just-expired callback before reusing its timer/cookie. */
+	hrtimer_cancel(&sdev->window_timer);
+	if (hint->bytes > sdev->rx_window_bytes)
+		return -E2BIG; /* No masking: caller uses ordinary IRQ path. */
+	spin_lock_irqsave(&sdev->window_lock, flags);
+	ret = tb_ring_poll_begin(sdev->rx_ring.ring);
+	if (!ret) {
+		sdev->window_cookie = hint->cookie;
+		sdev->window_deadline = ktime_add_us(ktime_get(), sdev->rx_window_us);
+		WRITE_ONCE(sdev->window_active, true);
+		hrtimer_start(&sdev->window_timer, sdev->window_deadline, HRTIMER_MODE_ABS_HARD);
+	}
+	spin_unlock_irqrestore(&sdev->window_lock, flags);
+	if (!ret)
+		wake_up_interruptible(&sdev->wait);
+	return ret;
+}
