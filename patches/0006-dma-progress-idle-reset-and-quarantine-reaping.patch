diff --git a/drivers/thunderbolt/dma_recovery.c b/drivers/thunderbolt/dma_recovery.c
new file mode 100644
--- /dev/null
+++ b/drivers/thunderbolt/dma_recovery.c
@@ -0,0 +1,199 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Included by domain.c. Explicit, exclusive NHI-v1 DMA recovery, never an
+ * automatic teardown quirk or a host-router/PCI reset. */
+#include <linux/bitfield.h>
+#include <linux/delay.h>
+#include <linux/pci.h>
+#include "nhi.h"
+#include "nhi_regs.h"
+
+#define TB_DMA_INTERFACE_RESET 0x39858
+#define TB_DMA_INTERFACE_RESET_RST BIT(0)
+
+static bool nhi_dma_idle_ring(struct tb_ring *ring)
+{
+	bool idle;
+
+	spin_lock(&ring->lock);
+	idle = !ring->running && list_empty(&ring->queue) &&
+	       list_empty(&ring->in_flight);
+	spin_unlock(&ring->lock);
+	return idle;
+}
+
+/* Paired with the same nhi->lock gate in ring allocation and ring start.
+ * Allocated-but-idle sibling rings are intentionally not considered free. */
+static int nhi_dma_reset_begin(struct tb_nhi *nhi,
+			       struct tb_ring *tx, struct tb_ring *rx)
+{
+	unsigned long flags;
+	unsigned int i;
+	int ret = 0;
+
+	spin_lock_irqsave(&nhi->lock, flags);
+	if (nhi->going_away || nhi->dma_shutdown) {
+		ret = -ENODEV;
+		goto unlock;
+	}
+	if (nhi->dma_resetting) {
+		ret = -EBUSY;
+		goto unlock;
+	}
+	if ((tx && (!tx->is_tx || tx->nhi != nhi || tx->hop <= 0 ||
+		    tx->hop >= nhi->hop_count || nhi->tx_rings[tx->hop] != tx)) ||
+	    (rx && (rx->is_tx || rx->nhi != nhi || rx->hop <= 0 ||
+		    rx->hop >= nhi->hop_count || nhi->rx_rings[rx->hop] != rx))) {
+		ret = -EINVAL;
+		goto unlock;
+	}
+	for (i = 1; i < nhi->hop_count; ++i) {
+		struct tb_ring *ring = nhi->tx_rings[i];
+
+		if (ring && (ring != tx || !nhi_dma_idle_ring(ring))) {
+			ret = -EBUSY;
+			goto unlock;
+		}
+		ring = nhi->rx_rings[i];
+		if (ring && (ring != rx || !nhi_dma_idle_ring(ring))) {
+			ret = -EBUSY;
+			goto unlock;
+		}
+	}
+	nhi->dma_resetting = true;
+unlock:
+	spin_unlock_irqrestore(&nhi->lock, flags);
+	return ret;
+}
+
+static void nhi_dma_reset_end(struct tb_nhi *nhi)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&nhi->lock, flags);
+	nhi->dma_resetting = false;
+	spin_unlock_irqrestore(&nhi->lock, flags);
+}
+
+/* Same AMD families as the pinned upstream reset-on-teardown workaround.
+ * Other vendors and unsupported NHI versions must not receive this write. */
+static bool nhi_dma_reset_supported(struct tb_nhi *nhi)
+{
+	struct pci_dev *pdev;
+
+	if (!dev_is_pci(nhi->dev))
+		return false;
+	pdev = to_pci_dev(nhi->dev);
+	if (pdev->vendor != PCI_VENDOR_ID_AMD)
+		return false;
+	switch (pdev->device) {
+	case PCI_DEVICE_ID_AMD_1AH_M60H_NHI0:
+	case PCI_DEVICE_ID_AMD_1AH_M60H_NHI1:
+	case PCI_DEVICE_ID_AMD_1AH_M68H_NHI0:
+	case PCI_DEVICE_ID_AMD_1AH_M68H_NHI1:
+	case PCI_DEVICE_ID_AMD_1AH_M80H_NHI0:
+	case PCI_DEVICE_ID_AMD_1AH_M80H_NHI1:
+	case PCI_DEVICE_ID_AMD_1AH_M80H_NHI2:
+	case PCI_DEVICE_ID_AMD_1AH_M24H_NHI0:
+	case PCI_DEVICE_ID_AMD_1AH_M24H_NHI1:
+	case PCI_DEVICE_ID_AMD_1AH_M70H_NHI0:
+	case PCI_DEVICE_ID_AMD_1AH_M70H_NHI1:
+		return true;
+	default:
+		return false;
+	}
+}
+
+static bool nhi_dma_control_running(struct tb_nhi *nhi)
+{
+	unsigned long flags;
+	struct tb_ring *tx, *rx;
+	bool running = false;
+
+	spin_lock_irqsave(&nhi->lock, flags);
+	tx = nhi->tx_rings[0];
+	rx = nhi->rx_rings[0];
+	if (tx && rx && !nhi->going_away && !nhi->dma_shutdown) {
+		/* Starts/stops also need nhi->lock; inspect the same-class ring
+		 * locks one at a time instead of nesting two of them. */
+		spin_lock(&tx->lock);
+		running = tx->running;
+		spin_unlock(&tx->lock);
+		spin_lock(&rx->lock);
+		running = running && rx->running;
+		spin_unlock(&rx->lock);
+	}
+	spin_unlock_irqrestore(&nhi->lock, flags);
+	return running;
+}
+
+/**
+ * tb_domain_reset_dma() - Reset an exclusively idle, supported AMD NHI
+ * @tb: Domain whose control channel is restarted over the reset
+ * @tx: Optional caller-owned stopped transmit ring
+ * @rx: Optional caller-owned stopped receive ring
+ *
+ * The caller must serialize its own ring lifetime/start/stop and remove its
+ * DMA paths first. Every other allocated non-control ring causes -EBUSY.
+ * A gate prevents new ring allocations and starts while the domain lock and
+ * runtime-PM reference serialize control-plane/power transitions. Nothing is
+ * forcibly stopped on behalf of another consumer. A failed post-reset read
+ * leaves admission closed until reprobe rather than asserting recovery.
+ */
+int tb_domain_reset_dma(struct tb *tb, struct tb_ring *tx, struct tb_ring *rx)
+{
+	struct tb_nhi *nhi = tb->nhi;
+	struct pci_dev *pdev;
+	u32 caps;
+	int ret;
+
+	if (!nhi_dma_reset_supported(nhi))
+		return -EOPNOTSUPP;
+	pdev = to_pci_dev(nhi->dev);
+	ret = pm_runtime_resume_and_get(nhi->dev);
+	if (ret < 0)
+		return ret;
+	mutex_lock(&tb->lock);
+	if (!device_is_registered(&tb->dev) || !pci_device_is_present(pdev) ||
+	    READ_ONCE(nhi->going_away) || READ_ONCE(nhi->dma_shutdown)) {
+		ret = -ENODEV;
+		goto unlock;
+	}
+	caps = ioread32(nhi->iobase + REG_CAPS);
+	if (caps == ~0U || !(caps & 0x3ff)) {
+		ret = -ENODEV;
+		goto unlock;
+	}
+	if (FIELD_GET(REG_CAPS_VERSION_MASK, caps) >= REG_CAPS_VERSION_2) {
+		ret = -EOPNOTSUPP;
+		goto unlock;
+	}
+	ret = nhi_dma_reset_begin(nhi, tx, rx);
+	if (ret)
+		goto unlock;
+
+	/* NHI-v1 reset affects ring registers and E2E credits, not PHY training.
+	 * Control HopID 0 is the only ring permitted to restart inside the gate. */
+	tb_ctl_stop(tb->ctl);
+	iowrite32(TB_DMA_INTERFACE_RESET_RST, nhi->iobase + TB_DMA_INTERFACE_RESET);
+	/* Posted-write flush followed by tHIReset, as in the pinned backend. */
+	ioread32(nhi->iobase + REG_CAPS);
+	usleep_range(10000, 20000);
+	if (!pci_device_is_present(pdev) || ioread32(nhi->iobase + REG_CAPS) != caps) {
+		ret = -EIO;
+		goto unlock; /* Keep dma_resetting: hardware state is not trusted. */
+	}
+	tb_ctl_start(tb->ctl);
+	if (!nhi_dma_control_running(nhi)) {
+		tb_ctl_stop(tb->ctl);
+		ret = -EIO;
+		goto unlock;
+	}
+	nhi_dma_reset_end(nhi);
+	ret = 0;
+unlock:
+	mutex_unlock(&tb->lock);
+	pm_runtime_mark_last_busy(nhi->dev);
+	pm_runtime_put_autosuspend(nhi->dev);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(tb_domain_reset_dma);
