+    lockdep_assert_held(&ctx->dma_lock);
+    spin_lock_irqsave(&ctx->lock, flags);
+    WRITE_ONCE(ctx->stopped, true);
+    WRITE_ONCE(ctx->started, false);
+    ++ctx->stats.dma_stops;
+    spin_unlock_irqrestore(&ctx->lock, flags);
+    if (sgu_ring_running(sdev->tx_ring.ring))
+        tb_ring_stop(sdev->tx_ring.ring);
+    if (sgu_ring_running(sdev->rx_ring.ring))
+        tb_ring_stop(sdev->rx_ring.ring);
+    /* Zero counters/running=false do not replace joining a callback that
+     * has already removed its final descriptor but is still signalling. */
+    flush_work(&sdev->tx_ring.ring->work);
+    flush_work(&sdev->rx_ring.ring->work);
+    running = sgu_ring_running(sdev->tx_ring.ring) || sgu_ring_running(sdev->rx_ring.ring);
+    spin_lock_irqsave(&ctx->lock, flags);
+    ctx->lifetime.stop_confirmed = 0;
+    if (running || !sgu_controller_stopped(&ctx->lifetime))
+        WRITE_ONCE(ctx->failed, true);
+    spin_unlock_irqrestore(&ctx->lock, flags);
+    wake_up_interruptible_poll(&sdev->wait, EPOLLIN | EPOLLERR);
+}
