+
+/* A whole page even for a 64-byte header: on RX a misrouted payload frame of
+ * up to SGU_FRAME_BYTES may land here and must stay inside kernel memory. */
+static int sgu_terminal_alloc(struct tbstream_gpu_context *ctx, u32 direction, u32 slot)
+{
+    struct device *device = sgu_ring_device(ctx, direction);
+    struct page *page = alloc_page(GFP_KERNEL | __GFP_ZERO);
+    dma_addr_t dma;
+
+    if (!page)
+        return -ENOMEM;
+    dma = dma_map_page(device, page, 0, SGU_FRAME_BYTES,
+                       direction == SGU_DIRECTION_TX ? DMA_TO_DEVICE : DMA_FROM_DEVICE);
+    if (dma_mapping_error(device, dma)) {
+        __free_page(page);
+        return -ENOMEM;
+    }
+    ctx->terminal_page[direction][slot] = page;
+    ctx->terminal_dma[direction][slot] = dma;
+    return 0;
+}
+
+/* Only after the rings stopped: no descriptor references these pages. */
+static void sgu_terminal_free_all(struct tbstream_gpu_context *ctx)
+{
+    u32 direction, slot;
+
+    for (direction = 0; direction < 2; ++direction) {
+        for (slot = 0; slot < SGU_MAX_QUEUE_DEPTH; ++slot) {
+            struct page *page = ctx->terminal_page[direction][slot];
+
+            if (!page)
+                continue;
+            dma_unmap_page(sgu_ring_device(ctx, direction), ctx->terminal_dma[direction][slot],
+                           SGU_FRAME_BYTES, direction == SGU_DIRECTION_TX ? DMA_TO_DEVICE : DMA_FROM_DEVICE);
+            __free_page(page);
+            ctx->terminal_page[direction][slot] = NULL;
+            ctx->terminal_dma[direction][slot] = 0;
+        }
+    }
+}
