+/* Terminal header sent by TX for SGU_PREPARE_TERMINAL_HEADER operations. */
+static inline void sgu_terminal_build(struct sgu_terminal_header *h, __u64 epoch, __u64 sequence,
+                                      __u64 payload_bytes, __u32 payload_frames, __u32 slot)
+{
+    memset(h, 0, sizeof(*h));
+    h->magic = sgu_le32(SGU_TERMINAL_MAGIC);
+    h->version = sgu_le16(SGU_TERMINAL_VERSION);
+    h->header_bytes = sgu_le16(SGU_TERMINAL_HEADER_BYTES);
+    h->connection_epoch = sgu_le64(epoch);
+    h->sequence = sgu_le64(sequence);
+    h->payload_bytes = sgu_le64(payload_bytes);
+    h->payload_frames = sgu_le32(payload_frames);
+    h->slot = sgu_le32(slot);
+}
+
+/* RX check of a received terminal frame against the local operation.
+ * actual_bytes is what the controller wrote: a payload frame that landed in
+ * the terminal slot fails on length or magic, a shifted or reordered
+ * operation on sequence/size, a stale peer on epoch. Returns 1 if valid. */
+static inline int sgu_terminal_valid(const struct sgu_terminal_header *h, __u32 actual_bytes,
+                                     __u64 epoch, __u64 sequence, __u64 payload_bytes,
+                                     __u32 payload_frames, __u32 slot)
+{
+    return actual_bytes == SGU_TERMINAL_HEADER_BYTES &&
+        sgu_from_le32(h->magic) == SGU_TERMINAL_MAGIC &&
+        sgu_from_le16(h->version) == SGU_TERMINAL_VERSION &&
+        sgu_from_le16(h->header_bytes) == SGU_TERMINAL_HEADER_BYTES &&
+        sgu_from_le64(h->connection_epoch) == epoch &&
+        sgu_from_le64(h->sequence) == sequence &&
+        sgu_from_le64(h->payload_bytes) == payload_bytes &&
+        sgu_from_le32(h->payload_frames) == payload_frames &&
+        sgu_from_le32(h->slot) == slot &&
+        !h->reserved[0] && !h->reserved[1] && !h->reserved[2];
+}
