+#define SGU_PREPARE_KNOWN_FLAGS SGU_PREPARE_TERMINAL_HEADER
+
 /* A frame fitting one 256-byte USB4 packet carries only its EOF PDF.
  * Strix Halo reports SOF=0 for that case. Multi-packet frames must retain
  * the START PDF, and every DATA frame still requires EOF=DATA.
@@ -93,7 +109,9 @@ static inline int sgu_prepare_valid(const struct sgu_prepare *p, __u32 frames, _
     __u64 count;
 
     if (!p || !payload_frames || frames < 32 || frames > SGU_MAX_FRAMES || !p->handle || !p->sequence || p->direction > SGU_DIRECTION_RX ||
-        p->reserved || !p->payload_bytes || !p->terminal_bytes || p->terminal_bytes > SGU_FRAME_BYTES ||
+        (p->flags & ~SGU_PREPARE_KNOWN_FLAGS) ||
+        ((p->flags & SGU_PREPARE_TERMINAL_HEADER) && p->terminal_bytes != SGU_TERMINAL_HEADER_BYTES) ||
+        !p->payload_bytes || !p->terminal_bytes || p->terminal_bytes > SGU_FRAME_BYTES ||
         p->pool_offset % SGU_FRAME_BYTES || p->pool_offset >= terminal || p->payload_bytes > terminal - p->pool_offset)
         return 0;
