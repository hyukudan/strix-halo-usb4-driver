 /**
+ * tb_domain_dma_paths_busy() - Check whether DMA tunnels still own ring IDs
+ * @tb: Retained domain whose connection manager owns the tunnel inventory
+ * @transmit_ring: Positive TX HopID, or -1 to ignore
+ * @receive_ring: Positive RX HopID, or -1 to ignore
+ *
+ * Both -1 queries all DMA tunnels. Returns 0 only on an affirmative inventory
+ * check, 1 for a matching tunnel, negative when no proof is available. The
+ * query deliberately does not wait for tb->lock (including recursive removal).
+ * This is path-table proof, not a hardware DMA-stop or GPU-consumer proof.
+ */
+int tb_domain_dma_paths_busy(struct tb *tb, int transmit_ring, int receive_ring)
+{
+	int ret;
+
+	if ((transmit_ring != -1 && transmit_ring <= 0) ||
+	    (receive_ring != -1 && receive_ring <= 0))
+		return -EINVAL;
+	if (!mutex_trylock(&tb->lock))
+		return -EAGAIN;
+	if (!tb->cm_ops || !tb->cm_ops->dma_paths_busy)
+		ret = -EOPNOTSUPP;
+	else
+		ret = tb->cm_ops->dma_paths_busy(tb, transmit_ring, receive_ring);
+	mutex_unlock(&tb->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(tb_domain_dma_paths_busy);
+
+/**
  * tb_domain_reset_dma() - Reset an exclusively idle, supported AMD NHI
  * @tb: Domain whose control channel is restarted over the reset
  * @tx: Optional caller-owned stopped transmit ring
@@ -167,6 +196,16 @@
 		ret = -EOPNOTSUPP;
 		goto unlock;
 	}
+	if (!tb->cm_ops || !tb->cm_ops->dma_paths_busy) {
+		ret = -EOPNOTSUPP;
+		goto unlock;
+	}
+	ret = tb->cm_ops->dma_paths_busy(tb, -1, -1);
+	if (ret) {
+		if (ret > 0)
+			ret = -EBUSY;
+		goto unlock;
+	}
 	ret = nhi_dma_reset_begin(nhi, tx, rx);
 	if (ret)
 		goto unlock;
