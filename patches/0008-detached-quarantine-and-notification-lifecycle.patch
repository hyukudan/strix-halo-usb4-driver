diff --git a/drivers/thunderbolt/xdomain_notify.h b/drivers/thunderbolt/xdomain_notify.h
new file mode 100644
--- /dev/null
+++ b/drivers/thunderbolt/xdomain_notify.h
@@ -0,0 +1,111 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Included in xdomain.c after the property-request implementation.
+ * The post-enumeration nudge is sent once per handshake, not once per remote
+ * property read. Genuine local changes have independent, bounded retry budgets.
+ * All fields below are protected by xd->lock; no XDomain request holds it.
+ */
+#ifndef TB_XDOMAIN_NOTIFY_H
+#define TB_XDOMAIN_NOTIFY_H
+
+static void tb_xdomain_notify_reset(struct tb_xdomain *xd)
+{
+	mutex_lock(&xd->lock);
+	xd->properties_post_enumeration = false;
+	xd->properties_notify_stopped = false;
+	xd->properties_notify_pending = false;
+	++xd->properties_notify_serial;
+	xd->properties_changed_retries = 0;
+	mutex_unlock(&xd->lock);
+}
+
+/* Close admission before cancel_delayed_work_sync; a concurrent local service
+ * update must not requeue notification work after suspend/removal canceled it. */
+static void tb_xdomain_notify_stop(struct tb_xdomain *xd)
+{
+	mutex_lock(&xd->lock);
+	xd->properties_notify_stopped = true;
+	xd->properties_notify_pending = false;
+	++xd->properties_notify_serial;
+	xd->properties_changed_retries = 0;
+	mutex_unlock(&xd->lock);
+}
+
+static void __tb_xdomain_queue_properties_changed(struct tb_xdomain *xd)
+{
+	lockdep_assert_held(&xd->lock);
+	if (xd->properties_notify_stopped || xd->removing || READ_ONCE(xd->is_unplugged))
+		return;
+	++xd->properties_notify_serial;
+	xd->properties_notify_pending = true;
+	xd->properties_changed_retries = XDOMAIN_RETRIES;
+	/* Do not postpone an already scheduled notification with mod_delayed_work.
+	 * Updates arriving during the request queue the next invocation instead. */
+	queue_delayed_work(xd->tb->wq, &xd->properties_changed_work,
+			   msecs_to_jiffies(XDOMAIN_SHORT_TIMEOUT));
+}
+
+static void tb_xdomain_queue_properties_changed(struct tb_xdomain *xd)
+{
+	mutex_lock(&xd->lock);
+	__tb_xdomain_queue_properties_changed(xd);
+	mutex_unlock(&xd->lock);
+}
+
+static void tb_xdomain_notify_enumerated(struct tb_xdomain *xd)
+{
+	mutex_lock(&xd->lock);
+	if (!xd->properties_post_enumeration && !xd->properties_notify_stopped &&
+	    !xd->removing &&
+	    !READ_ONCE(xd->is_unplugged)) {
+		xd->properties_post_enumeration = true;
+		__tb_xdomain_queue_properties_changed(xd);
+	}
+	mutex_unlock(&xd->lock);
+}
+
+static void tb_xdomain_properties_changed(struct work_struct *work)
+{
+	struct tb_xdomain *xd = container_of(work, typeof(*xd),
+					     properties_changed_work.work);
+	u32 serial;
+	int retries, ret;
+
+	mutex_lock(&xd->lock);
+	if (!xd->properties_notify_pending || xd->properties_notify_stopped ||
+	    xd->removing ||
+	    READ_ONCE(xd->is_unplugged)) {
+		xd->properties_notify_pending = false;
+		mutex_unlock(&xd->lock);
+		return;
+	}
+	serial = xd->properties_notify_serial;
+	retries = xd->properties_changed_retries;
+	mutex_unlock(&xd->lock);
+
+	ret = tb_xdp_properties_changed_request(xd->tb->ctl, xd->route,
+					      retries, xd->local_uuid);
+
+	mutex_lock(&xd->lock);
+	/* A service update or a new handshake invalidates this request's result.
+	 * In particular an old success must not swallow a newer local change, nor
+	 * may an old error consume the new generation's retry budget. */
+	if (serial != xd->properties_notify_serial)
+		goto unlock;
+	if (xd->properties_notify_stopped || xd->removing || READ_ONCE(xd->is_unplugged)) {
+		xd->properties_notify_pending = false;
+		goto unlock;
+	}
+	if (!ret) {
+		xd->properties_notify_pending = false;
+	} else if (retries > 0) {
+		xd->properties_changed_retries = retries - 1;
+		queue_delayed_work(xd->tb->wq, &xd->properties_changed_work,
+				   msecs_to_jiffies(XDOMAIN_DEFAULT_TIMEOUT));
+	} else {
+		xd->properties_notify_pending = false;
+		dev_warn(&xd->dev, "properties notification exhausted: %d\n", ret);
+	}
+unlock:
+	mutex_unlock(&xd->lock);
+}
+#endif
