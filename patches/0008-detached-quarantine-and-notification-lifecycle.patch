diff --git a/drivers/thunderbolt/dma_path_query.h b/drivers/thunderbolt/dma_path_query.h
new file mode 100644
--- /dev/null
+++ b/drivers/thunderbolt/dma_path_query.h
@@ -0,0 +1,23 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Included by tb.c after its private CM and tunnel declarations. */
+#ifndef TB_DMA_PATH_QUERY_H
+#define TB_DMA_PATH_QUERY_H
+static int tb_dma_paths_busy(struct tb *tb, int transmit_ring, int receive_ring)
+{
+	struct tb_cm *tcm = tb_priv(tb);
+	struct tb_tunnel *tunnel;
+
+	lockdep_assert_held(&tb->lock);
+	list_for_each_entry(tunnel, &tcm->tunnel_list, list) {
+		if (!tb_tunnel_is_dma(tunnel))
+			continue;
+		if ((transmit_ring < 0 && receive_ring < 0) ||
+		    (transmit_ring > 0 &&
+		     tb_tunnel_match_dma(tunnel, -1, transmit_ring, -1, -1)) ||
+		    (receive_ring > 0 &&
+		     tb_tunnel_match_dma(tunnel, -1, -1, -1, receive_ring)))
+			return 1;
+	}
+	return 0;
+}
+#endif
