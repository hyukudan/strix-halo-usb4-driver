+static bool rx_napi;
+module_param(rx_napi, bool, 0644);
+MODULE_PARM_DESC(rx_napi,
+		 "Reap RX completions in the reader (start_poll, NAPI style) instead of ring work; applies when a stream is opened (default: false)");
+
+static unsigned int spin_us;
+module_param(spin_us, uint, 0644);
+MODULE_PARM_DESC(spin_us,
+		 "With rx_napi, keep polling the RX ring this many microseconds before re-arming its interrupt (default: 0)");
+
+/* Hard IRQ context, nhi->lock and ring->lock held: the ring is masked. */
+static void tbstream_rx_start_poll(void *data)
+{
+	struct tbstream_dev *sdev = data;
+
+	WRITE_ONCE(sdev->rx_poll_pending, true);
+	wake_up_interruptible_poll(&sdev->wait, EPOLLIN | EPOLLRDNORM);
+}
+
+/*
+ * Reap RX completions in the caller, the only consumer while the ring
+ * interrupt is masked, so frames are delivered in ring order. Optionally
+ * keep polling for spin_us, then re-arm the interrupt and reap once more
+ * to close the race with a frame completing just before the unmask.
+ * Called with sdev->lock held.
+ */
+static void tbstream_dev_napi_rx(struct tbstream_dev *sdev, bool spin)
+{
+	struct tb_ring *ring = sdev->rx_ring.ring;
+	struct ring_frame *frame;
+	ktime_t end;
+
+	if (!sdev->rx_napi)
+		return;
+
+	WRITE_ONCE(sdev->rx_poll_pending, false);
+	end = ktime_add_us(ktime_get(), spin ? READ_ONCE(spin_us) : 0);
+	for (;;) {
+		while ((frame = tb_ring_poll(ring)))
+			frame->callback(ring, frame, false);
+		if (tbstream_ring_available(&sdev->rx_ring))
+			return;
+		if (!spin || need_resched() || signal_pending(current) ||
+		    !ktime_before(ktime_get(), end))
+			break;
+		cpu_relax();
+	}
+
+	tb_ring_poll_complete(ring);
+	while ((frame = tb_ring_poll(ring)))
+		frame->callback(ring, frame, false);
+}
