+
+/* Registry entries exist only while their contexts hold the original domain.
+ * The registry lock never nests an sdev lock. A sweep snapshots one sdev ref
+ * plus a monotonic registration ID, then revalidates under sdev->lock. */
+static DEFINE_MUTEX(sgu_clients_lock);
+static LIST_HEAD(sgu_clients);
+static u64 sgu_client_serial;
+
+static int sgu_register_client(struct tbstream_gpu_context *ctx)
+{
+    int ret = 0;
+
+    INIT_LIST_HEAD(&ctx->client_node);
+    mutex_lock(&sgu_clients_lock);
+    if (sgu_client_serial == U64_MAX) {
+        ret = -EOVERFLOW;
+    } else {
+        ctx->client_id = ++sgu_client_serial;
+        list_add_tail(&ctx->client_node, &sgu_clients);
+    }
