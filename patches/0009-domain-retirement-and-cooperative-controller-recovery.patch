 }
+int tb_domain_reset_dma(struct tb *tb, struct tb_ring *tx, struct tb_ring *rx)
+{
+    struct tb_ring *rings[2];
+    unsigned int count = 0;
+
+    if ((tx && !tx->is_tx) || (rx && rx->is_tx))
+        return -EINVAL;
+    if (tx)
+        rings[count++] = tx;
+    if (rx)
+        rings[count++] = rx;
+    return __tb_domain_reset_dma(tb, rings, count, NULL);
+}
 EXPORT_SYMBOL_GPL(tb_domain_reset_dma);
+
+/* Registered only during a consumer module's init/exit, never while holding
+ * its per-file mutex. This avoids notifier-unregister versus callback ABBA. */
+static BLOCKING_NOTIFIER_HEAD(tb_dma_lifecycle_notifiers);
+/* Separate from teardown: its callback takes sdev locks, while reset is called
+ * with those locks already held. Sharing a writer-preferring notifier rwsem
+ * would permit an unregister/callback/reset ABBA. Recovery has only network
+ * consumers, whose RTNL admission is nonblocking. */
+static BLOCKING_NOTIFIER_HEAD(tb_dma_recovery_notifiers);
+
+int tb_register_dma_recovery_notifier(struct notifier_block *notifier)
+{
+    return blocking_notifier_chain_register(&tb_dma_recovery_notifiers, notifier);
+}
+EXPORT_SYMBOL_GPL(tb_register_dma_recovery_notifier);
+
+int tb_unregister_dma_recovery_notifier(struct notifier_block *notifier)
+{
+    return blocking_notifier_chain_unregister(&tb_dma_recovery_notifiers, notifier);
+}
+EXPORT_SYMBOL_GPL(tb_unregister_dma_recovery_notifier);
+
+int tb_register_dma_lifecycle_notifier(struct notifier_block *notifier)
+{
+    return blocking_notifier_chain_register(&tb_dma_lifecycle_notifiers, notifier);
+}
+EXPORT_SYMBOL_GPL(tb_register_dma_lifecycle_notifier);
+
+int tb_unregister_dma_lifecycle_notifier(struct notifier_block *notifier)
+{
+    return blocking_notifier_chain_unregister(&tb_dma_lifecycle_notifiers, notifier);
+}
+EXPORT_SYMBOL_GPL(tb_unregister_dma_lifecycle_notifier);
+
+/* Called by domain.c after CM stop and queued removal work have completed,
+ * outside tb->lock, before deinit/unregister can discard the inventory. The
+ * parent's remove path still owns its MMIO/devres while domain refs exist. */
+static void tb_dma_retire_domain_clients(struct tb *tb)
+{
+    blocking_notifier_call_chain(&tb_dma_lifecycle_notifiers,
+                                TB_DMA_DOMAIN_QUIESCING, tb);
+}
+
+
+static int tb_dma_execute_group_reset(struct tb_dma_reset_request *request)
+{
+    return __tb_domain_reset_dma(request->tb, request->rings,
+                                 request->nrings, request->performed);
+}
+
+/**
+ * tb_domain_reset_dma_group() - Cooperatively reset an owner-held idle group
+ * @tb: Retained domain
+ * @rings: Unique non-control rings, serialized and pinned by all owners
+ * @nrings: Bounded owner-held ring set
+ * @flags: TB_DMA_RESET_WITH_NETWORK explicitly permits USB4NET down/up
+ * @performed: Set before destructive reset/control-stop, including failures
+ *
+ * With NETWORK, a registered network consumer wraps the continuation while
+ * holding RTNL. It closes only its interfaces on this domain, then restores
+ * the previously-up interfaces after success or a nondestructive rejection.
+ * Other allocated rings/tunnels remain a veto. No force-unbind or packet replay.
+ * The caller must serialize the NHI device binding against driver removal for
+ * this entire call (including the optional network close/open continuation).
+ */
+int tb_domain_reset_dma_group(struct tb *tb, struct tb_ring *const *rings,
+                              unsigned int nrings, unsigned int flags,
+                              bool *performed)
+{
+    struct tb_dma_reset_request request = {
+        .tb = tb, .rings = rings, .nrings = nrings, .performed = performed,
+        .execute = tb_dma_execute_group_reset,
+    };
+
+    if (!performed)
+        return -EINVAL;
+    *performed = false;
+    if (nrings > TB_DMA_RESET_MAX_RINGS || (nrings && !rings) ||
+        (flags & ~TB_DMA_RESET_WITH_NETWORK))
+        return -EINVAL;
+    /* Reject unsupported/removing controllers before any network outage. */
+    if (READ_ONCE(tb->nhi->going_away) || READ_ONCE(tb->nhi->dma_shutdown))
+        return -ENODEV;
+    if (!nhi_dma_reset_supported(tb->nhi))
+        return -EOPNOTSUPP;
+    if (flags & TB_DMA_RESET_WITH_NETWORK)
+        blocking_notifier_call_chain(&tb_dma_recovery_notifiers,
+                                    TB_DMA_GROUP_RECOVERY, &request);
+    if (!request.handled)
+        request.status = request.execute(&request);
+    return request.status;
+}
+EXPORT_SYMBOL_GPL(tb_domain_reset_dma_group);
diff --git a/drivers/thunderbolt/gpu_group_reset.h b/drivers/thunderbolt/gpu_group_reset.h
new file mode 100644
--- /dev/null
+++ b/drivers/thunderbolt/gpu_group_reset.h
@@ -0,0 +1,180 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Included after the GPU lifecycle helpers. No userspace access or FD release
+ * occurs with an sdev/DMA mutex held. fget keeps every participant's open-file
+ * identity alive; duplicate sdevs (including dup FDs) are rejected first. */
+static long sgu_reset_group_ioctl(struct file *caller, void __user *user)
+{
+    struct sgu_group_owner {
+        struct file *file;
+        struct tbstream_dev *sdev;
+        struct tbstream_gpu_context *ctx;
+        bool locked, dma_locked;
+    } owners[SGU_MAX_RESET_MEMBERS] = {};
+    struct tb_ring *rings[2 * SGU_MAX_RESET_MEMBERS];
+    struct sgu_reset_group *request;
+    struct tb *domain = NULL;
+    struct device *controller = NULL;
+    bool controller_locked = false;
+    unsigned int i, j, count = 0;
+    bool contains_caller = false, performed = false;
+    long ret;
+
+    if (!capable(CAP_SYS_ADMIN))
+        return -EPERM;
+    request = kzalloc(sizeof(*request), GFP_KERNEL);
+    if (!request)
+        return -ENOMEM;
+    if (copy_from_user(request, user, sizeof(*request))) {
+        ret = -EFAULT;
+        goto free_request;
+    }
+    if (!request->count || request->count > SGU_MAX_RESET_MEMBERS ||
+        request->result || request->reserved ||
+        (request->flags & ~SGU_RESET_GROUP_NETWORK)) {
+        ret = -EINVAL;
+        goto free_request;
+    }
+    count = request->count;
+    if (memchr_inv(&request->members[count], 0,
+                  (SGU_MAX_RESET_MEMBERS - count) * sizeof(request->members[0]))) {
+        ret = -EINVAL;
+        goto free_request;
+    }
+    for (i = 0; i < count; ++i) {
+        const struct sgu_reset_member *member = &request->members[i];
+        struct file *file;
+
+        if (member->reserved || member->fd < 0) {
+            ret = -EINVAL;
+            goto unlock;
+        }
+        file = fget(member->fd);
+        if (!file) {
+            ret = -EBADF;
+            goto unlock;
+        }
+        owners[i].file = file;
+        if (file->f_op != &tbstream_dev_fops) {
+            ret = -EINVAL;
+            goto unlock;
+        }
+        owners[i].sdev = to_tbstream_dev(file->private_data);
+        if (file == caller)
+            contains_caller = true;
+        for (j = 0; j < i; ++j) {
+            if (owners[i].sdev == owners[j].sdev) {
+                ret = -EINVAL;
+                goto unlock;
+            }
+        }
+    }
+    if (!contains_caller) {
+        ret = -EINVAL;
+        goto unlock;
+    }
+    /* Nonblocking multi-lock admission avoids opposing caller lock orders.
+     * Contention is failure without any STOP, state mutation or reset. */
+    for (i = 0; i < count; ++i) {
+        struct tbstream_dev *sdev = owners[i].sdev;
+        struct tbstream_gpu_context *ctx;
+        struct tb_xdomain *xd;
+
+        if (!mutex_trylock(&sdev->lock)) {
+            ret = -EAGAIN;
+            goto unlock;
+        }
+        owners[i].locked = true;
+        ctx = sdev->gpu_context;
+        if (!sdev->gpu_direct || sdev->users <= 0 || !ctx ||
+            tbstream_dev_valid(sdev) || sdev->stream != ctx->stream_owner) {
+            ret = -ENODEV;
+            goto unlock;
+        }
+        if (memcmp(&request->members[i].fence, &ctx->identity,
+                   sizeof(ctx->identity))) {
+            ret = -ESTALE;
+            goto unlock;
+        }
+        owners[i].ctx = ctx;
+        if (!mutex_trylock(&ctx->dma_lock)) {
+            ret = -EAGAIN;
+            goto unlock;
+        }
+        owners[i].dma_locked = true;
+        if (!ctx->stopped || !sgu_can_release(ctx) || ctx->quarantined) {
+            ret = -EBUSY;
+            goto unlock;
+        }
+        xd = sgu_original_xdomain(ctx);
+        if (domain && domain != xd->tb) {
+            ret = -EXDEV;
+            goto unlock;
+        }
+        domain = xd->tb;
+        rings[2 * i] = sdev->tx_ring.ring;
+        rings[2 * i + 1] = sdev->rx_ring.ring;
+    }
+    /* A retained struct device does not pin its devres/driver binding. A
+     * nonblocking device lock avoids ABBA with remove waiting for sdev->lock. */
+    controller = get_device(owners[0].ctx->dma_owner);
+    if (!device_trylock(controller)) {
+        ret = -EAGAIN;
+        goto unlock;
+    }
+    controller_locked = true;
+    if (!device_is_bound(controller) || dev_get_drvdata(controller) != domain ||
+        READ_ONCE(domain->nhi->going_away) || READ_ONCE(domain->nhi->dma_shutdown)) {
+        ret = -ENODEV;
+        goto unlock;
+    }
+    /* The core rechecks the ENTIRE ring and tunnel inventories under its
+     * admission/CM locks. User-provided completeness is never trusted. */
+    ret = tb_domain_reset_dma_group(domain, rings, 2 * count,
+        request->flags & SGU_RESET_GROUP_NETWORK ? TB_DMA_RESET_WITH_NETWORK : 0,
+        &performed);
+    for (i = 0; i < count; ++i) {
+        struct tbstream_gpu_context *ctx = owners[i].ctx;
+        unsigned long flags;
+
+        spin_lock_irqsave(&ctx->lock, flags);
+        if (ret) {
+            ++ctx->stats.reset_failures;
+        } else {
+            ++ctx->stats.resets;
+        }
+        if (performed) {
+            /* Reset is not a transparent resumption or an import release.
+             * RECOVER and a larger agreed epoch are mandatory for every FD. */
+            WRITE_ONCE(ctx->failed, true);
+            ctx->requires_new_epoch = true;
+        }
+        spin_unlock_irqrestore(&ctx->lock, flags);
+        if (performed)
+            wake_up_interruptible_poll(&ctx->sdev->wait, EPOLLERR);
+    }
+    if (!ret)
+        request->result = SGU_RESULT_GROUP_RESET;
+unlock:
+    if (controller_locked)
+        device_unlock(controller);
+    if (controller)
+        put_device(controller);
+    for (i = count; i > 0; --i) {
+        struct sgu_group_owner *owner = &owners[i - 1];
+
+        if (owner->dma_locked)
+            mutex_unlock(&owner->ctx->dma_lock);
+        if (owner->locked)
+            mutex_unlock(&owner->sdev->lock);
+    }
+    /* A fault after successful reset does not undo the reset. Every member
+     * remains failed and requires RECOVER, even if the result copy is lost. */
+    if (!ret && copy_to_user(user, request, sizeof(*request)))
+        ret = -EFAULT;
+    for (i = 0; i < count; ++i)
+        if (owners[i].file)
+            fput(owners[i].file);
+free_request:
+    kfree(request);
+    return ret;
+}
diff --git a/drivers/thunderbolt/gpu_stream.c b/drivers/thunderbolt/gpu_stream.c
--- a/drivers/thunderbolt/gpu_stream.c
+++ b/drivers/thunderbolt/gpu_stream.c
@@ -14,6 +14,9 @@
 #include <linux/sync_file.h>
 #include <linux/workqueue.h>
 #include <linux/capability.h>
