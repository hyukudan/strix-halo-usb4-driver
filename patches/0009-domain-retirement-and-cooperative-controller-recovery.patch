     spinlock_t lock; /* callbacks never acquire either process-context mutex */
     /* No allocation, user access, reservation wait or path operation under this
      * mutex. The watchdog deliberately never acquires sdev->lock. */
@@ -101,6 +107,36 @@
     bool closing, requires_new_epoch;
