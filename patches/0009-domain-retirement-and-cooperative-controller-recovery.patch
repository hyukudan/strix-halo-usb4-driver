diff --git a/drivers/net/thunderbolt/dma_recovery.h b/drivers/net/thunderbolt/dma_recovery.h
new file mode 100644
--- /dev/null
+++ b/drivers/net/thunderbolt/dma_recovery.h
@@ -0,0 +1,106 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Included by main.c after struct tbnet. RTNL serializes interface lifecycle,
+ * ring ownership, this registry and the entire close/reset/reopen transaction.
+ * This is a short administrative outage, not a guarantee of packet delivery. */
+#include <linux/notifier.h>
+#include <linux/rtnetlink.h>
+
+#define TBNET_DMA_MAX_CLIENTS 64U
+static LIST_HEAD(tbnet_dma_clients);
+
+static void tbnet_dma_register_device(struct tbnet *net)
+{
+    rtnl_lock();
+    list_add_tail(&net->recovery_node, &tbnet_dma_clients);
+    rtnl_unlock();
+}
+
+static void tbnet_dma_unregister_device(struct tbnet *net)
+{
+    rtnl_lock();
+    list_del_init(&net->recovery_node);
+    rtnl_unlock();
+}
+
+static int tbnet_dma_recovery_notify(struct notifier_block *notifier,
+                                    unsigned long event, void *data)
+{
+    struct tb_dma_reset_request *request = data;
+    struct net_device **up;
+    struct tbnet *net;
+    unsigned int count = 0, closed = 0, i;
+    int ret = 0;
+    bool stop_unproved = false;
+
+    if (event != TB_DMA_GROUP_RECOVERY || request->handled)
+        return NOTIFY_DONE;
+    request->handled = true;
+    if (!rtnl_trylock()) {
+        request->status = -EAGAIN;
+        return NOTIFY_OK;
+    }
+    /* Preflight every candidate before changing a single administrative flag.
+     * Registry and netdev identity cannot change while we retain RTNL. */
+    list_for_each_entry(net, &tbnet_dma_clients, recovery_node) {
+        if (net->xd->tb != request->tb)
+            continue;
+        if (READ_ONCE(net->xd->is_unplugged) ||
+            !netif_device_present(net->dev)) {
+            ret = -ENODEV;
+            goto unlock;
+        }
+        if (netif_running(net->dev) && ++count > TBNET_DMA_MAX_CLIENTS) {
+            ret = -E2BIG;
+            goto unlock;
+        }
+    }
+    up = kcalloc(count ?: 1, sizeof(*up), GFP_KERNEL);
+    if (!up) {
+        ret = -ENOMEM;
+        goto unlock;
+    }
+    list_for_each_entry(net, &tbnet_dma_clients, recovery_node) {
+        if (net->xd->tb != request->tb || !netif_running(net->dev))
+            continue;
+        up[closed++] = net->dev;
+        /* Normal ndo_stop handles NAPI, login/disconnect work, DMA rings and
+         * paths. It is never emulated by merely zeroing a ring pointer. */
+        dev_close(net->dev);
+        if (net->tx_ring.ring || net->rx_ring.ring) {
+            stop_unproved = true;
+            ret = -EBUSY;
+            goto restore;
+        }
+    }
+    ret = request->execute(request);
+restore:
+    /* An attempted but unproved reset leaves interfaces down. A failed ioctl
+     * is not permission to restart DMA onto unknown ring register state. */
+    if (!stop_unproved && (!*request->performed || !ret)) {
+        for (i = 0; i < closed; ++i) {
+            int error = dev_open(up[i], NULL);
+
+            if (!ret && error)
+                ret = error;
+        }
+    }
+    kfree(up);
+unlock:
+    rtnl_unlock();
+    request->status = ret;
+    return NOTIFY_OK;
+}
+
+static struct notifier_block tbnet_dma_lifecycle_notifier = {
+    .notifier_call = tbnet_dma_recovery_notify,
+};
+
+static int tbnet_dma_lifecycle_init(void)
+{
+    return tb_register_dma_recovery_notifier(&tbnet_dma_lifecycle_notifier);
+}
+
+static void tbnet_dma_lifecycle_exit(void)
+{
+    tb_unregister_dma_recovery_notifier(&tbnet_dma_lifecycle_notifier);
+}
