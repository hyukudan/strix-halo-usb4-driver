+/* End of local domain teardown, before CM deinit and NHI devres release.
+ * Normal open FDs must not pin a safely stopped controller indefinitely. An
+ * old FD becomes an error-only handle; sdev->users still prevents re-opening
+ * a replacement context until that FD is released. Exported fences own their
+ * own references and remain usable. No GPU completion is inferred here. */
+static int sgu_domain_quiescing(struct notifier_block *notifier,
+                               unsigned long event, void *data)
+{
+    struct tb *tb = data;
+    u64 cursor = 0;
+    unsigned int retained = 0;
+
+    if (event != TB_DMA_DOMAIN_QUIESCING)
+        return NOTIFY_DONE;
+    if (!READ_ONCE(tb->nhi->dma_shutdown))
+        return NOTIFY_BAD;
+    for (;;) {
+        struct tbstream_gpu_context *entry, *ctx;
+        struct tbstream_dev *sdev = NULL;
+        u64 id = 0;
+
+        mutex_lock(&sgu_clients_lock);
+        list_for_each_entry(entry, &sgu_clients, client_node) {
+            if (entry->domain_owner == &tb->dev && entry->client_id > cursor) {
+                sdev = entry->sdev;
+                id = entry->client_id;
+                tbstream_dev_get(sdev);
+                break;
+            }
+        }
+        mutex_unlock(&sgu_clients_lock);
+        if (!sdev)
+            break;
+        cursor = id;
+        mutex_lock(&sdev->lock);
+        ctx = sdev->gpu_context;
+        if (ctx && ctx->client_id == id && ctx->domain_owner == &tb->dev) {
+            WRITE_ONCE(ctx->failed, true);
+            ctx->path_check_required = true;
+            tbstream_gpu_close(sdev);
+            if (sdev->gpu_context)
+                ++retained;
+            wake_up_interruptible_poll(&sdev->wait, EPOLLHUP | EPOLLERR);
+        }
+        mutex_unlock(&sdev->lock);
+        tbstream_dev_put(sdev);
+    }
+    if (retained)
+        dev_warn(&tb->dev, "%u GPU contexts retained: DMA/path quiescence unproved\n", retained);
+    /* Do not prevent other consumers from running their cleanup callbacks. */
+    return NOTIFY_OK;
+}
+
+static struct notifier_block sgu_lifecycle_notifier = {
+    .notifier_call = sgu_domain_quiescing,
+};
+
+static int tbstream_gpu_lifecycle_init(void)
+{
+    return tb_register_dma_lifecycle_notifier(&sgu_lifecycle_notifier);
+}
+
+static void tbstream_gpu_lifecycle_exit(void)
+{
+    tb_unregister_dma_lifecycle_notifier(&sgu_lifecycle_notifier);
+}
