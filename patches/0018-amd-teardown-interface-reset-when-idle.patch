@@ -202,7 +203,8 @@ EXPORT_SYMBOL_GPL(tb_domain_dma_paths_busy);
  */
 static int __tb_domain_reset_dma(struct tb *tb,
                                   struct tb_ring *const *rings,
-                                  unsigned int nrings, bool *performed)
+                                  unsigned int nrings, bool *performed,
+                                  bool nowait)
 {
 	struct tb_nhi *nhi = tb->nhi;
 	struct pci_dev *pdev;
@@ -215,7 +217,12 @@ static int __tb_domain_reset_dma(struct tb *tb,
 	ret = pm_runtime_resume_and_get(nhi->dev);
 	if (ret < 0)
 		return ret;
-	mutex_lock(&tb->lock);
+	if (!nowait) {
+		mutex_lock(&tb->lock);
+	} else if (!mutex_trylock(&tb->lock)) {
+		ret = -EAGAIN;
+		goto put;
+	}
 	if (!device_is_registered(&tb->dev) || !pci_device_is_present(pdev) ||
 	    READ_ONCE(nhi->going_away) || READ_ONCE(nhi->dma_shutdown)) {
 		ret = -ENODEV;
@@ -267,10 +274,108 @@ static int __tb_domain_reset_dma(struct tb *tb,
 	ret = 0;
 unlock:
 	mutex_unlock(&tb->lock);
+put:
 	pm_runtime_mark_last_busy(nhi->dev);
 	pm_runtime_put_autosuspend(nhi->dev);
 	return ret;
 }
+/*
+ * Recovery after a DMA path teardown. The AMD v1 host interfaces of
+ * nhi_dma_reset_supported() may hang their TX side when DMA paths are torn
+ * down, which also stops the control channel (ring 0 of the same engine).
+ * Upstream resets the interface after every teardown, wiping the rings of
+ * every other user. Here the reset only runs once the NHI is idle: no
+ * allocated ring besides the control ring it restarts, no DMA tunnel in the
+ * CM and no other reset in progress (the admission of tb_domain_reset_dma()
+ * with an empty ring set). It is retried a bounded number of times, never
+ * waits for the domain lock, and logs what it did or what was in the way.
+ */
+static bool teardown_reset = true;
+module_param(teardown_reset, bool, 0644);
+MODULE_PARM_DESC(teardown_reset,
+		 "reset AMD v1 host interfaces after a DMA path teardown, only when no other ring is allocated (default: true)");
+
+#define TB_TEARDOWN_RESET_DELAY_MS	100
+#define TB_TEARDOWN_RESET_RETRY_MS	500
+#define TB_TEARDOWN_RESET_ATTEMPTS	10
+
+static void nhi_dma_count_rings(struct tb_nhi *nhi, unsigned int *tx,
+				unsigned int *rx)
+{
+	unsigned long flags;
+	unsigned int i;
+
+	*tx = 0;
+	*rx = 0;
+	spin_lock_irqsave(&nhi->lock, flags);
+	for (i = 1; i < nhi->hop_count; i++) {
+		*tx += !!nhi->tx_rings[i];
+		*rx += !!nhi->rx_rings[i];
+	}
+	spin_unlock_irqrestore(&nhi->lock, flags);
+}
+
+static void tb_domain_teardown_reset_work(struct work_struct *work)
+{
+	struct tb *tb = container_of(to_delayed_work(work), struct tb,
+				     teardown_reset_work);
+	unsigned int attempt = READ_ONCE(tb->teardown_reset_attempts) + 1;
+	unsigned int tx, rx;
+	bool performed = false;
+	int ret;
+
+	WRITE_ONCE(tb->teardown_reset_attempts, attempt);
+	ret = __tb_domain_reset_dma(tb, NULL, 0, &performed, true);
+	if (!ret) {
+		dev_info(&tb->dev, "host interface reset after DMA teardown (attempt %u)\n",
+			 attempt);
+		return;
+	}
+	if (performed) {
+		dev_err(&tb->dev, "host interface reset after DMA teardown failed: %d, new rings are refused until the NHI is probed again\n",
+			ret);
+		return;
+	}
+	/* Domain going away, controller gone, not a v1 interface, PM error */
+	if (ret != -EBUSY && ret != -EAGAIN) {
+		dev_dbg(&tb->dev, "no host interface reset after DMA teardown: %d\n", ret);
+		return;
+	}
+	if (attempt < TB_TEARDOWN_RESET_ATTEMPTS) {
+		queue_delayed_work(tb->wq, &tb->teardown_reset_work,
+				   msecs_to_jiffies(TB_TEARDOWN_RESET_RETRY_MS));
+		return;
+	}
+	nhi_dma_count_rings(tb->nhi, &tx, &rx);
+	dev_warn(&tb->dev, "no host interface reset after DMA teardown: %s after %u attempts (%u TX and %u RX rings allocated besides control; a DMA tunnel or a reset in progress also prevents it)\n",
+		 ret == -EAGAIN ? "domain lock busy" : "NHI in use", attempt, tx, rx);
+}
+
+/**
+ * tb_domain_schedule_teardown_reset() - Recover the interface after a teardown
+ * @tb: Domain whose DMA path was just torn down
+ *
+ * Only on the quirked AMD v1 host interfaces and while the domain is not
+ * going away. A new teardown restarts the attempt budget.
+ */
+void tb_domain_schedule_teardown_reset(struct tb *tb)
+{
+	struct tb_nhi *nhi = READ_ONCE(tb->nhi);
+	unsigned long flags;
+	bool stopping;
+
+	if (!READ_ONCE(teardown_reset) || !nhi || !nhi_dma_reset_supported(nhi))
+		return;
+	spin_lock_irqsave(&nhi->lock, flags);
+	stopping = nhi->going_away || nhi->dma_shutdown;
+	spin_unlock_irqrestore(&nhi->lock, flags);
+	if (stopping)
+		return;
+	WRITE_ONCE(tb->teardown_reset_attempts, 0);
+	mod_delayed_work(tb->wq, &tb->teardown_reset_work,
+			 msecs_to_jiffies(TB_TEARDOWN_RESET_DELAY_MS));
+}
+
 int tb_domain_reset_dma(struct tb *tb, struct tb_ring *tx, struct tb_ring *rx)
 {
     struct tb_ring *rings[2];
@@ -282,7 +387,7 @@ int tb_domain_reset_dma(struct tb *tb, struct tb_ring *tx, struct tb_ring *rx)
         rings[count++] = tx;
     if (rx)
         rings[count++] = rx;
-    return __tb_domain_reset_dma(tb, rings, count, NULL);
+    return __tb_domain_reset_dma(tb, rings, count, NULL, false);
 }
 EXPORT_SYMBOL_GPL(tb_domain_reset_dma);
 
@@ -403,7 +508,7 @@ static void tb_dma_retire_domain_clients(struct tb *tb)
 static int tb_dma_execute_group_reset(struct tb_dma_reset_request *request)
 {
     return __tb_domain_reset_dma(request->tb, request->rings,
-                                 request->nrings, request->performed);
+                                 request->nrings, request->performed, false);
 }
 
