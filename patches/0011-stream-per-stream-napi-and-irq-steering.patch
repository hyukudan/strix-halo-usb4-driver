 	if (ret)
@@ -1231,6 +1257,79 @@ tbstream_dev_busy_poll_store(struct config_item *item, const char *buf,
 }
 CONFIGFS_ATTR(tbstream_dev_, busy_poll);
 
+#define TBSTREAM_DEV_MAX_SPIN_US	1000
+
+static ssize_t tbstream_dev_int_store(struct tbstream_dev *sdev, int *field,
+				      const char *buf, size_t count, int min, int max)
+{
+	int value, ret;
+
+	ret = kstrtoint(buf, 0, &value);
+	if (ret)
+		return ret;
+	if (value < min || value > max)
+		return -EINVAL;
+
+	guard(mutex)(&sdev->lock);
+	if (tbstream_dev_config_busy(sdev))
+		return -EBUSY;
+	*field = value;
+	return count;
+}
+
+static ssize_t tbstream_dev_rx_napi_show(struct config_item *item, char *buf)
+{
+	struct tbstream_dev *sdev = tbstream_dev_from_group(to_config_group(item));
+
+	return sysfs_emit(buf, "%d\n", sdev->cfg_rx_napi);
+}
+
+/* -1 follows the rx_napi module parameter, 0 disables, 1 enables. */
+static ssize_t tbstream_dev_rx_napi_store(struct config_item *item,
+					  const char *buf, size_t count)
+{
+	struct tbstream_dev *sdev = tbstream_dev_from_group(to_config_group(item));
+
+	return tbstream_dev_int_store(sdev, &sdev->cfg_rx_napi, buf, count, -1, 1);
+}
+CONFIGFS_ATTR(tbstream_dev_, rx_napi);
+
+static ssize_t tbstream_dev_spin_us_show(struct config_item *item, char *buf)
+{
+	struct tbstream_dev *sdev = tbstream_dev_from_group(to_config_group(item));
+
+	return sysfs_emit(buf, "%d\n", sdev->cfg_spin_us);
+}
+
+/* -1 follows the spin_us module parameter. */
+static ssize_t tbstream_dev_spin_us_store(struct config_item *item,
+					  const char *buf, size_t count)
+{
+	struct tbstream_dev *sdev = tbstream_dev_from_group(to_config_group(item));
+
+	return tbstream_dev_int_store(sdev, &sdev->cfg_spin_us, buf, count, -1,
+				      TBSTREAM_DEV_MAX_SPIN_US);
+}
+CONFIGFS_ATTR(tbstream_dev_, spin_us);
+
+static ssize_t tbstream_dev_irq_cpu_show(struct config_item *item, char *buf)
+{
+	struct tbstream_dev *sdev = tbstream_dev_from_group(to_config_group(item));
+
+	return sysfs_emit(buf, "%d\n", sdev->irq_cpu);
+}
+
+/* -1 lets the kernel place the ring interrupts. */
+static ssize_t tbstream_dev_irq_cpu_store(struct config_item *item,
+					  const char *buf, size_t count)
+{
+	struct tbstream_dev *sdev = tbstream_dev_from_group(to_config_group(item));
+
+	return tbstream_dev_int_store(sdev, &sdev->irq_cpu, buf, count, -1,
+				      nr_cpu_ids - 1);
+}
+CONFIGFS_ATTR(tbstream_dev_, irq_cpu);
